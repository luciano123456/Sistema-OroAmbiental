<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Oro Ambiental</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=6.0" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/RpDataTable.css?v=3.2" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/GridViewMode.css?v=1.9" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaOroAmbiental.Application.styles.css" asp-append-version="true" />
    <style>
        html, body { background: transparent !important; }
        body.fg-embed { padding: 0 !important; margin: 0 !important; background: transparent !important; }
        body.fg-embed .container-fluid.mt-4 { margin-top: 0 !important; padding-left: 0 !important; padding-right: 0 !important; }
        body.fg-embed .vi-header.cc-header { border-radius: 12px !important; }
    </style>
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body class="fg-embed">

    <main role="main">
        @RenderBody()
    </main>

    <partial name="~/Views/Utils/Modals.cshtml" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/SessionManager.js?v=5.2" asp-append-version="true"></script>
    <script src="~/js/site.js?v=7.2" asp-append-version="true"></script>
    <script src="~/js/GridViewMode.js?v=1.7" asp-append-version="true"></script>
    <script src="~/js/Utils/RpVerFicha.js?v=5.2" asp-append-version="true"></script>
    <script src="~/js/Utils/ValidacionModalAbm.js?v=5.2" asp-append-version="true"></script>
    <script src="~/js/Permisos.js?v=5.2" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
