                </div>

                <button type="button"
                        class="btn-close rp-btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- MENSAJE LISTA VACIA -->
                <label id="lblListaVacia"
                       class="rp-empty-label"
                       hidden>
                </label>

                <!-- BUSCADOR -->
                <div class="rp-search-box" id="contenedorBuscadorConfiguracion">
                    <i class="fa fa-search rp-search-icon"></i>
                    <input type="text"
                           id="txtBuscarConfiguracion"
                           class="rp-input rp-search-input"
                           placeholder="Buscar configuracion...">
                </div>

                <!-- LISTA -->
                <div class="rp-list-container" id="configuracion-list">
                    <!-- Se llena dinamicamente -->
                </div>

                <!-- PANEL EDICION -->
                <div id="contenedorNombreConfiguracion"
                     class="rp-edit-panel"
                     hidden>

                    <label id="lblNombreConfiguracion"
                           class="rp-label"
                           for="txtNombreConfiguracion">
                        Nombre
                    </label>

                    <input type="text"
                           class="rp-input"
                           id="txtNombreConfiguracion">

                    <div id="divConfiguracionCodigo" style="margin-top:12px;" hidden>
                        <label id="lblCodigoConfiguracion"
                               class="rp-label"
                               for="txtCodigoConfiguracion">
                            Codigo
                        </label>

                        <input type="text"
                               class="rp-input"
                               id="txtCodigoConfiguracion"
                               maxlength="10">
                    </div>

                    <input type="hidden"
                           id="txtIdConfiguracion">

                    <!-- COMBO OPCIONAL -->
                    <div id="divConfiguracionCombo" style="margin-top:12px;" hidden>
                        <label id="lblConfiguracionCombo"
                               class="rp-label">
                        </label>

                        <select id="cmbConfiguracion"
                                class="rp-input">
                        </select>
                    </div>

                    <div id="divConfiguracionPartido" style="margin-top:12px;" hidden>
                        <label id="lblConfiguracionPartido"
                               class="rp-label"
                               for="cmbConfiguracionPartido">
                            Partido
                        </label>

                        <select id="cmbConfiguracionPartido"
                                class="rp-input">
                        </select>
                    </div>

                    <div id="divConfiguracionTipoCuenta" style="margin-top:12px;" hidden>
                        <label id="lblConfiguracionTipoCuenta"
                               class="rp-label"
                               for="cmbConfiguracionTipoCuenta">
                            Tipo cuenta
                        </label>

                        <select id="cmbConfiguracionTipoCuenta"
                                class="rp-input">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Banco">Banco</option>
                        </select>
                    </div>

                    <!-- BOTONES -->
                    <div class="rp-edit-actions">
                        <button id="btnRegistrarModificarConfiguracion"
                                class="rp-btn rp-btn-primary"
                                onclick="guardarCambiosConfiguracion()">
                            <i class="fa fa-check"></i>
                            Guardar
                        </button>

                        <button class="rp-btn rp-btn-soft"
                                onclick="cancelarModificarConfiguracion()">
                            <i class="fa fa-times"></i>
                            Cancelar
                        </button>
                    </div>

                </div>

                <!-- BOTON ANADIR -->
                <div class="rp-add-container">
                    <button id="agregarConfiguracion"
                            class="rp-btn rp-btn-primary"
                            onclick="agregarConfiguracion()">
                        <i class="fa fa-plus"></i>
                        Anadir nuevo
                    </button>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer rp-modal-footer">
                <button type="button" class="rp-btn rp-btn-soft"
                        data-bs-dismiss="modal"
                        onclick="volverConfiguraciones()">
                    <i class="fa fa-arrow-left"></i>
                    Volver
                </button>
            </div>

        </div>
    </div>
</div>


