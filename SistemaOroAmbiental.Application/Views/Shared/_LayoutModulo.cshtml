<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Oro Ambiental</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/site.css?v=5.3" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/GridViewMode.css?v=1.6" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaOroAmbiental.Application.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body class="layout-modulo">

    <partial name="~/Views/Shared/Partials/NavBarLogin.cshtml" />

    <div class="row g-0 layout-modulo-logo">
        <div class="col-lg-12 divLogo">
            <img src="/Imagenes/logo.png" class="img-fluid imageLogo" alt="Logo Oro Ambiental">
        </div>
    </div>

    <div class="container-fluid px-3 px-lg-4 pb-4 layout-modulo-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/SessionManager.js?v=5.1" asp-append-version="true"></script>
    <script src="~/js/site.js?v=5.5" asp-append-version="true"></script>
    <script src="~/js/GridViewMode.js?v=1.5" asp-append-version="true"></script>
    <script src="~/js/Utils/RpVerFicha.js?v=5.1" asp-append-version="true"></script>
    <script src="~/js/Utils/ValidacionModalAbm.js?v=5.1" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
