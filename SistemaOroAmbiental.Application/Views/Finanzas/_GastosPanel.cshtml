<div class="fg-gastos-root gastos-index">
<div class="fg-panel-toolbar mb-3">
    <div>
        <h4 class="m-0 fw-800">Gastos</h4>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button id="gsBtnRefresh" class="btn btn-outline-light vi-btn" type="button">
            <i class="fa fa-refresh me-2"></i> Actualizar
        </button>
        <button id="gsBtnNuevo" class="btn btn-success vi-btn" type="button" data-permiso="crear" data-modulo="Gastos">
            <i class="fa fa-plus me-2"></i> Nuevo gasto
        </button>
    </div>
</div>

<div class="rp-filtros-wrap mb-3" id="panelFiltrosGastosHubWrap">
    <div class="rp-filtros-head" data-bs-toggle="collapse" data-bs-target="#panelFiltrosGastosHub" aria-expanded="false">
        <div class="title">
            <i class="fa fa-filter"></i>
            <span>Filtros</span>
        </div>
        <i class="fa fa-chevron-down chev"></i>
    </div>
    <div id="panelFiltrosGastosHub" class="collapse">
        <div class="rp-filtros-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <div class="rp-filter-label">Fecha desde</div>
                    <input type="date" id="gsFechaDesde" class="rp-filter-input" />
                </div>
                <div class="col-md-2">
                    <div class="rp-filter-label">Fecha hasta</div>
                    <input type="date" id="gsFechaHasta" class="rp-filter-input" />
                </div>
                <div class="col-md-2">
                    <div class="rp-filter-label">Categoria</div>
                    <select id="gsCategoria" class="rp-filter-select select2" style="width:100%"></select>
                </div>
                <div class="col-md-2">
                    <div class="rp-filter-label">Sucursal</div>
                    <select id="gsSucursal" class="rp-filter-select select2" style="width:100%"></select>
                </div>
                <div class="col-md-2">
                    <div class="rp-filter-label">Cuenta</div>
                    <select id="gsCuenta" class="rp-filter-select select2" style="width:100%"></select>
                </div>
                <div class="col-md-2">
                    <div class="rp-filter-label">Importe min.</div>
                    <input type="number" step="0.01" id="gsImporteMin" class="rp-filter-input" placeholder="0" />
                </div>
                <div class="col-md-12">
                    <div class="rp-filter-label">Concepto contiene</div>
                    <input type="text" id="gsConcepto" class="rp-filter-input" placeholder="Buscar por concepto..." />
                </div>
            </div>
            <div class="rp-filtros-actions mt-3">
                <button class="btn btn-outline-light vi-btn" type="button" onclick="limpiarFiltrosGastos()">
                    <i class="fa fa-eraser"></i> Limpiar
                </button>
                <button class="btn btn-primary vi-btn" type="button" onclick="aplicarFiltrosGastos()">
                    <i class="fa fa-check"></i> Aplicar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="cc-kpis gastos-kpis mb-3">
    <div class="cc-kpi"><div class="lbl">Gastos</div><div class="val" id="gsKpiCant">0</div></div>
    <div class="cc-kpi"><div class="lbl">Total gastado</div><div class="val" id="gsKpiTotal">$ 0,00</div></div>
    <div class="cc-kpi"><div class="lbl">IVA</div><div class="val" id="gsKpiIva">$ 0,00</div></div>
</div>

<div class="cc-toolbar mb-2">
    <div class="cc-toolbar-actions"></div>
    <div class="dropdown cc-dd">
        <button class="btn btn-secondary dropdown-toggle" type="button" id="gsDropdownColumnas"
                data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside">
            <i class="fa fa-cog me-2"></i> Config. Columnas
        </button>
        <ul class="dropdown-menu cc-dropdown-menu" id="gsConfigColumnasMenu"></ul>
    </div>
</div>

<div class="dt-dark-wrap">
    <table class="dt-dark display nowrap compact" id="grd_GastosHub" style="width:100%">
        <thead>
            <tr>
                <th></th>
                <th>Id</th>
                <th>Fecha</th>
                <th>Categoria</th>
                <th>Sucursal</th>
                <th>Cuenta</th>
                <th>Ref.</th>
                <th>Concepto</th>
                <th class="text-end">Neto</th>
                <th class="text-end">IVA %</th>
                <th class="text-end">IVA</th>
                <th class="text-end">Otros imp.</th>
                <th class="text-end">Total</th>
                <th>Nota</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<div class="cc-card mt-3" id="gsDashWrap" style="display:none;" data-permiso="dashboard" data-modulo="Gastos">
    <div class="cc-card-body">
        <div class="accordion rp-acc" id="gsAccordionDash">
            <div class="accordion-item">
                <h2 class="accordion-header" id="gsDashHead">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#gsDashBody" aria-expanded="false">
                        <i class="fa fa-bar-chart me-2"></i> Analisis de gastos
                    </button>
                </h2>
                <div id="gsDashBody" class="accordion-collapse collapse" data-bs-parent="#gsAccordionDash">
                    <div class="accordion-body gastos-dash-body">
                        <div class="rp-dash-grid gastos-dash-grid">
                            <div class="rp-dash-card gastos-dash-card">
                                <div class="rp-dash-title gastos-dash-title">
                                    <span class="t"><i class="fa fa-pie-chart"></i> Por categoria</span>
                                </div>
                                <div class="gastos-dash-chart-wrap">
                                    <canvas id="gsChartCategoria"></canvas>
                                </div>
                            </div>
                            <div class="rp-dash-card gastos-dash-card">
                                <div class="rp-dash-title gastos-dash-title">
                                    <span class="t"><i class="fa fa-building"></i> Por cuenta</span>
                                </div>
                                <div class="gastos-dash-chart-wrap">
                                    <canvas id="gsChartCuenta"></canvas>
                                </div>
                            </div>
                            <div class="rp-dash-card gastos-dash-card">
                                <div class="rp-dash-title gastos-dash-title">
                                    <span class="t"><i class="fa fa-line-chart"></i> Evolucion mensual</span>
                                </div>
                                <div class="gastos-dash-chart-wrap">
                                    <canvas id="gsChartMes"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@await Html.PartialAsync("~/Views/Entities/M_Gastos.cshtml")
