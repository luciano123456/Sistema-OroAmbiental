@* Modal reutilizable de Productos (Oro Ambiental) *@

<div class="modal fade producto-modal-root"
     data-producto-modal="producto"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="modalEdicionLabel">Nuevo Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="errorCampos" class="rp-error-panel d-none mb-2">
                    <div class="rp-error-icon"><i class="fa fa-exclamation-triangle"></i></div>
                    <div class="rp-error-content">
                        <div class="rp-error-title">No se pudo guardar</div>
                        <div class="rp-error-message"></div>
                    </div>
                    <button type="button" class="rp-error-close" onclick="cerrarErrorCampos()">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <div class="rp-tabs-shell">
                    <ul class="nav rp-tabs-modern">
                        <li class="nav-item">
                            <button class="nav-link active" id="tabBtnDatosProd" data-bs-toggle="tab" data-bs-target="#tabDatosProd" type="button">
                                <i class="fa fa-cube"></i><span>Datos</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="tabBtnListasProd" data-bs-toggle="tab" data-bs-target="#tabListasProd" type="button">
                                <i class="fa fa-tags"></i><span>Lista de precios</span>
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="tab-content mt-3">
                    <div class="tab-pane fade show active" id="tabDatosProd">
                        <form class="row g-3">
                            <input type="text" id="txtId" hidden />

                            <div class="col-md-8">
                                <label class="form-label">Nombre</label>
                                <input id="txtNombre" class="form-control" required />
                                <div class="invalid-feedback">Campo obligatorio</div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Abreviatura</label>
                                <input id="txtAbreviatura" class="form-control" maxlength="20" placeholder="Ej. C/C" />
                                <div class="form-text text-muted">Se muestra en la hoja de ruta.</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Categoria</label>
                                <div class="rp-select-plus">
                                    <select id="cmbCategoria" class="form-control"></select>
                                    <button type="button" id="btnAtajoCategoria" class="rp-btn-plus" title="Agregar categoria"
                                            data-config-nombre="Productos Categorias" data-config-controller="ProductosCategorias">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback">Campo obligatorio</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Unidad de medida</label>
                                <div class="rp-select-plus">
                                    <select id="cmbMedida" class="form-control"></select>
                                    <button type="button" id="btnAtajoMedida" class="rp-btn-plus" title="Agregar medida"
                                            data-config-nombre="Unidades de Medida" data-config-controller="UnidadesMedida">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback">Campo obligatorio</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label d-flex align-items-center justify-content-between gap-2">
                                    <span>Costo unitario</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" id="btnHistorialCosto"
                                            title="Ver historial de costo">
                                        <i class="fa fa-history"></i> Historial
                                    </button>
                                </label>
                                <input id="txtCostoUnitario" type="text" inputmode="decimal" autocomplete="off" class="form-control Inputmiles" required />
                                <div class="invalid-feedback">Campo obligatorio</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Stock minimo</label>
                                <input id="txtStockMinimo" type="text" min="0" class="form-control Inputmiles" inputmode="numeric" autocomplete="off" value="0" />
                                <div class="invalid-feedback">Valor invalido</div>
                            </div>

                            <div class="col-md-4">
                                <div class="rp-activo-box h-100">
                                    <div class="rp-activo-box-head">
                                        <span class="rp-activo-box-title">Estado del registro</span>
                                        <span class="rp-activo-box-sub">Productos inactivos no se listan por defecto.</span>
                                    </div>
                                    <label class="rp-switch mb-0 rp-switch-block">
                                        <input type="checkbox" id="chkActivoProducto" class="rp-switch-input" checked>
                                        <span class="rp-switch-slider"></span>
                                        <span class="rp-activo-estado-text" id="lblActivoProducto">Activo</span>
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <div class="rp-activo-box rp-hoja-ruta-box h-100">
                                    <div class="rp-activo-box-head">
                                        <span class="rp-activo-box-title"><i class="fa fa-map-o"></i> Hoja de ruta</span>
                                        <span class="rp-activo-box-sub">Precio del encabezado · un solo producto por tipo.</span>
                                    </div>
                                    <div class="rp-hoja-ruta-chips" role="group" aria-label="Rol en hoja de ruta">
                                        <label class="rp-hoja-chip" for="chkDescartadorChicoHoja">
                                            <input type="checkbox" id="chkDescartadorChicoHoja" class="rp-hoja-chip-input">
                                            <span class="rp-hoja-chip-ui">
                                                <i class="fa fa-cube" aria-hidden="true"></i>
                                                <span>Descartador chico</span>
                                            </span>
                                        </label>
                                        <label class="rp-hoja-chip" for="chkDescartadorGrandeHoja">
                                            <input type="checkbox" id="chkDescartadorGrandeHoja" class="rp-hoja-chip-input">
                                            <span class="rp-hoja-chip-ui">
                                                <i class="fa fa-cubes" aria-hidden="true"></i>
                                                <span>Descartador grande</span>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="rp-hoja-ruta-alert" id="alertHojaRuta" role="status">
                                        <i class="fa fa-info-circle" id="alertHojaRutaIcon" aria-hidden="true"></i>
                                        <span id="alertHojaRutaTexto">Marcá un tipo para usar el precio de venta de este producto en el encabezado de la hoja.</span>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="tabListasProd">
                        <div class="rp-precios-section">
                            <div class="rp-precios-header">
                                <div class="rp-precios-header-icon"><i class="fa fa-tags"></i></div>
                                <div>
                                    <h6 class="rp-precios-title mb-0">Lista de precios</h6>
                                    <small class="rp-precios-sub">Las listas generales (Configuraciones) aparecen en todos los productos. Las que agregás acá son solo de este producto.</small>
                                </div>
                            </div>

                            <button type="button" id="btnAtajoListaPrecioProd" class="rp-precios-add">
                                <span class="rp-precios-add-icon"><i class="fa fa-tags"></i></span>
                                <span class="rp-precios-add-text">
                                    <strong>Nueva lista de este producto</strong>
                                    <small>No se comparte con el resto del catálogo. Para todos los productos, usá Configuraciones.</small>
                                </span>
                                <span class="rp-precios-add-action">Agregar</span>
                            </button>

                            <div id="lblPreciosSinListas" class="rp-precios-empty d-none">
                                <i class="fa fa-info-circle"></i>
                                <span>Todavía no hay listas. Creá una general en <strong>Configuraciones</strong> o una solo para este producto con el botón de arriba.</span>
                            </div>

                            <div id="gridPreciosLista" class="rp-precios-grid"></div>
                        </div>
                    </div>
                </div>

                <div class="rp-auditoria d-none mt-3" id="infoAuditoria">
                    <div id="infoRegistro"></div>
                    <div id="infoModificacion"></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left"></i> Volver
                </button>
                <button type="button" id="btnGuardar" class="btn btn-primary" onclick="guardarProducto()">
                    <i class="fa fa-check"></i> Registrar
                </button>
            </div>
        </div>
    </div>
</div>

@* Historial de costo unitario *@
<div class="modal fade" id="modalHistorialCosto" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header colorEncabezado">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="histCostoTitulo">Historial de costo</h5>
                    <small class="text-muted-cc d-block" id="histCostoSub"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="histCostoLoading" class="prod-hist-loading">
                    <i class="fa fa-spinner fa-spin"></i> Cargando historial...
                </div>
                <div id="histCostoEmpty" class="prod-hist-empty d-none">
                    <i class="fa fa-info-circle"></i>
                    <span>No hay movimientos de costo registrados para este producto.</span>
                </div>
                <div id="histCostoActual" class="prod-hist-actual d-none"></div>
                <div id="histCostoTimeline" class="prod-hist-timeline d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@* Nueva lista exclusiva de este producto *@
<div class="modal fade" id="modalNuevaListaProducto" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rp-lista-prod-modal">
            <div class="modal-header rp-lista-prod-head">
                <div class="rp-lista-prod-head-icon"><i class="fa fa-tag"></i></div>
                <div class="min-w-0">
                    <h5 class="modal-title fw-bold mb-0">Nueva lista de este producto</h5>
                    <small class="rp-lista-prod-head-sub" id="lblNuevaListaProductoSub">Solo aplica a este producto, no al catálogo completo.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="rp-lista-prod-field">
                    <label class="form-label" for="txtNuevaListaNombre">Nombre de la lista</label>
                    <input id="txtNuevaListaNombre" class="form-control" maxlength="100" placeholder="Ej. Mayorista efectivo" autocomplete="off" />
                </div>
                <div class="rp-lista-prod-field">
                    <label class="form-label">Tipo de pago</label>
                    <div id="gridNuevaListaTipoPago" class="rp-lista-prod-tipos" role="group" aria-label="Tipo de pago"></div>
                    <input type="hidden" id="hidNuevaListaTipoPago" value="" />
                </div>
                <div class="rp-lista-prod-grid">
                    <div class="rp-lista-prod-field">
                        <label class="form-label" for="txtNuevaListaPrecio">Precio venta <span class="rp-lista-prod-opcional">(opcional)</span></label>
                        <input id="txtNuevaListaPrecio" type="text" inputmode="decimal" autocomplete="off" class="form-control Inputmiles" placeholder="0,00" />
                    </div>
                    <div class="rp-lista-prod-field">
                        <label class="form-label" for="txtNuevaListaRent">% Rentabilidad <span class="rp-lista-prod-opcional">(opcional)</span></label>
                        <input id="txtNuevaListaRent" type="text" inputmode="decimal" autocomplete="off" class="form-control Inputmiles" placeholder="0,00" />
                    </div>
                </div>
            </div>
            <div class="modal-footer rp-lista-prod-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn rp-lista-prod-save" id="btnGuardarNuevaListaProducto">
                    <i class="fa fa-check"></i> Crear lista
                </button>
            </div>
        </div>
    </div>
</div>
