@* Modal Establecimientos de Clientes *@

<div class="modal fade establecimiento-modal-root"
     data-establecimiento-modal="establecimiento"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="modalEstablecimientoLabel">Nuevo Establecimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <partial name="~/Views/Entities/_EstablecimientoEditorBody.cshtml" />
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left"></i> Volver
                </button>
                <button type="button" id="btnGuardarEst" class="btn btn-primary" onclick="guardarEstablecimiento()">
                    <i class="fa fa-check"></i> Registrar establecimiento
                </button>
            </div>

        </div>
    </div>
</div>
