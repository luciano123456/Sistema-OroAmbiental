@{
    Layout = "~/Views/Shared/_LayoutModulo.cshtml";
    ViewData["Title"] = "Mis datos";
}

@section Estilos {
    <link href="~/css/Usuarios.css?v=5.7" rel="stylesheet" />
}

<div class="rp-perfil-page">
    <div class="rp-perfil-shell">
        <header class="rp-perfil-hero">
            <div class="rp-perfil-hero-inner">
                <div class="rp-perfil-hero-top">
                    <div class="rp-perfil-avatar-wrap">
                        <div class="rp-perfil-avatar" id="rpPerfilAvatar">--</div>
                    </div>
                    <div class="rp-perfil-hero-main">
                        <p class="rp-perfil-kicker">Configuracion de cuenta</p>
                        <h1 class="rp-perfil-hero-title">Mis datos</h1>
                        <div class="rp-perfil-hero-meta">
                            <span class="rp-perfil-meta-item rp-perfil-meta-item--user">
                                <i class="fa fa-user"></i>
                                <span id="rpPerfilUsuario">...</span>
                            </span>
                            <span class="rp-perfil-meta-item rp-perfil-meta-item--ok">
                                <i class="fa fa-check-circle"></i> Sesion activa
                            </span>
                        </div>
                    </div>
                </div>
                <p class="rp-perfil-hero-sub">
                    Actualiza tu nombre, contacto y contrasena. Los cambios se aplican a tu usuario en todo el sistema.
                </p>
            </div>
        </header>

        <div id="msjerror" class="rp-perfil-alert d-none" role="alert"></div>

        <form id="formularioActualizar" class="rp-perfil-form" autocomplete="off">
            <input type="hidden" id="Id" name="Id" />

            <section class="rp-perfil-block">
                <div class="rp-perfil-block-head">
                    <span class="rp-perfil-block-icon teal"><i class="fa fa-user"></i></span>
                    <div>
                        <h2>Informacion personal</h2>
                        <p>Datos visibles en el sistema y reportes.</p>
                    </div>
                </div>
                <div class="row g-4 g-xl-5 rp-perfil-grid">
                    <div class="col-md-6">
                        <label for="Nombre" class="rp-perfil-label">Nombre (*)</label>
                        <div class="rp-perfil-field">
                            <i class="fa fa-user-o"></i>
                            <input type="text" class="form-control" id="Nombre" name="Nombre" maxlength="100" required placeholder="Tu nombre" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="Apellido" class="rp-perfil-label">Apellido (*)</label>
                        <div class="rp-perfil-field">
                            <i class="fa fa-user-o"></i>
                            <input type="text" class="form-control" id="Apellido" name="Apellido" maxlength="100" required placeholder="Tu apellido" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="DNI" class="rp-perfil-label">DNI</label>
                        <div class="rp-perfil-field">
                            <i class="fa fa-id-card-o"></i>
                            <input type="text" class="form-control" id="DNI" name="DNI" maxlength="20" placeholder="Documento" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="Telefono" class="rp-perfil-label">Telefono</label>
                        <div class="rp-perfil-field">
                            <i class="fa fa-phone"></i>
                            <input type="text" class="form-control" id="Telefono" name="Telefono" maxlength="50" placeholder="Contacto" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="Correo" class="rp-perfil-label">Correo</label>
                        <div class="rp-perfil-field">
                            <i class="fa fa-envelope-o"></i>
                            <input type="email" class="form-control" id="Correo" name="Correo" maxlength="120" placeholder="email@ejemplo.com" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="Direccion" class="rp-perfil-label">Direccion</label>
                        <div class="rp-perfil-field">
                            <i class="fa fa-map-marker"></i>
                            <input type="text" class="form-control" id="Direccion" name="Direccion" maxlength="200" placeholder="Calle, numero, localidad" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="rp-perfil-block">
                <div class="rp-perfil-block-head">
                    <span class="rp-perfil-block-icon amber"><i class="fa fa-lock"></i></span>
                    <div>
                        <h2>Seguridad</h2>
                        <p>Confirma con tu contrasena actual para guardar cambios.</p>
                    </div>
                </div>
                <div class="row g-4 g-xl-5 rp-perfil-grid">
                    <div class="col-md-6">
                        <label for="Contrasena" class="rp-perfil-label">Contrasena actual (*)</label>
                        <div class="rp-perfil-field">
                            <i class="fa fa-key"></i>
                            <input type="password" class="form-control" id="Contrasena" name="Contrasena" required autocomplete="current-password" placeholder="********" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="ContrasenaNueva" class="rp-perfil-label">Contrasena nueva</label>
                        <div class="rp-perfil-field">
                            <i class="fa fa-refresh"></i>
                            <input type="password" class="form-control" id="ContrasenaNueva" name="ContrasenaNueva" autocomplete="new-password" placeholder="Opcional" />
                        </div>
                        <small class="rp-perfil-hint">Dejala vacia si no queres cambiarla.</small>
                    </div>
                </div>
            </section>

            <section class="rp-perfil-block rp-perfil-block--last">
                <div class="rp-perfil-block-head">
                    <span class="rp-perfil-block-icon purple"><i class="fa fa-th-large"></i></span>
                    <div>
                        <h2>Preferencias</h2>
                        <p>Como se muestran los listados en este navegador.</p>
                    </div>
                </div>
                <label class="rp-perfil-label rp-perfil-label--spaced" for="rpConfigViewMode">Vista de listados</label>
                <div class="rp-perfil-pills-wrap">
                    <div class="rp-perfil-pills" id="rpPerfilViewPills" role="group" aria-label="Vista de listados">
                        <button type="button" class="rp-perfil-pill" data-view="auto">
                            <i class="fa fa-magic"></i>
                            <span>Automatico</span>
                            <small>PC tabla / movil tarjetas</small>
                        </button>
                        <button type="button" class="rp-perfil-pill" data-view="table">
                            <i class="fa fa-table"></i>
                            <span>Siempre tabla</span>
                            <small>Grilla completa</small>
                        </button>
                        <button type="button" class="rp-perfil-pill" data-view="cards">
                            <i class="fa fa-th"></i>
                            <span>Siempre tarjetas</span>
                            <small>Vista compacta</small>
                        </button>
                    </div>
                </div>
                <select class="form-control d-none" id="rpConfigViewMode" aria-hidden="true" tabindex="-1">
                    <option value="auto">Automatico (tabla en PC, tarjetas en movil)</option>
                    <option value="table">Siempre tabla</option>
                    <option value="cards">Siempre tarjetas</option>
                </select>
            </section>

            <footer class="rp-perfil-footer">
                <button type="submit" id="btnGuardar" class="rp-perfil-btn rp-perfil-btn--primary">
                    <i class="fa fa-check"></i> Guardar cambios
                </button>
            </footer>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/UsuariosConfiguracion.js?v=5.7"></script>
}
