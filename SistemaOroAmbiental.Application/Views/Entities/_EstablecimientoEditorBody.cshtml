@{
    var incluirStock = ViewData["IncluirStockEst"] as bool? == true;
    var incluirManifiestos = incluirStock || ViewData["IncluirManifiestosEst"] as bool? == true;
}

<div id="errorCamposEst" class="rp-error-panel d-none mb-2">
    <div class="rp-error-icon"><i class="fa fa-exclamation-triangle"></i></div>
    <div class="rp-error-content">
        <div class="rp-error-title">No se pudo guardar</div>
        <div class="rp-error-message"></div>
    </div>
    <button type="button" class="rp-error-close" onclick="cerrarErrorCamposEst()">
        <i class="fa fa-times"></i>
    </button>
</div>

<div class="rp-tabs-shell">
    <ul class="nav rp-tabs-modern">
        <li class="nav-item">
            <button class="nav-link active" id="tabBtnDatosEst" data-bs-toggle="tab" data-bs-target="#tabDatosEst" type="button">
                <i class="fa fa-building"></i><span>Datos</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tabBtnContactosEst" data-bs-toggle="tab" data-bs-target="#tabContactosEst" type="button">
                <i class="fa fa-address-book"></i><span>Contactos</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tabBtnTercerosEst" data-bs-toggle="tab" data-bs-target="#tabTercerosEst" type="button">
                <i class="fa fa-exchange"></i><span>Pago de terceros</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tabBtnContratosEst" data-bs-toggle="tab" data-bs-target="#tabContratosEst" type="button">
                <i class="fa fa-file-text-o"></i><span>Contratos</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tabBtnProductosEst" data-bs-toggle="tab" data-bs-target="#tabProductosEst" type="button">
                <i class="fa fa-cube"></i><span>Productos</span>
            </button>
        </li>
        @if (incluirManifiestos)
        {
            <li class="nav-item">
                <button class="nav-link" id="tabBtnManifiestosEst" data-bs-toggle="tab" data-bs-target="#tabManifiestosEst" type="button">
                    <i class="fa fa-file-text-o"></i><span>Manifiestos</span>
                </button>
            </li>
        }
        @if (incluirStock)
        {
            <li class="nav-item">
                <button class="nav-link" id="tabBtnStockEst" data-bs-toggle="tab" data-bs-target="#tabStockEst" type="button">
                    <i class="fa fa-calendar-check-o"></i><span>Control de pagos y stock</span>
                </button>
            </li>
        }
    </ul>
</div>

<div class="tab-content mt-3">

    <div class="tab-pane fade show active" id="tabDatosEst">
        <form class="row g-3">
            <input type="text" id="txtIdEst" hidden />

            <div class="col-md-6" id="wrapClienteEst">
                <label class="form-label" for="cmbClienteEst">Cliente</label>
                <div class="rp-select-plus">
                    <select id="cmbClienteEst" class="form-control" required></select>
                    <button type="button"
                            id="btnAgregarClienteEst"
                            class="rp-btn-plus"
                            title="Agregar cliente">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
                <div class="form-text text-muted">No requiere contrato. Si no hay clientes, usa el boton +.</div>
                <div class="invalid-feedback">Campo obligatorio</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Nombre establecimiento</label>
                <input id="txtNombreEst" class="form-control" required maxlength="100" />
                <div class="invalid-feedback">Campo obligatorio</div>
            </div>

            <div class="col-md-3">
                <label class="form-label">Id establecimiento</label>
                <input id="txtIdEstablecimientoClienteEst" class="form-control" maxlength="@IntercambioTxtCampos.CodigoOpds" />
            </div>

            <div class="col-md-4">
                <label class="form-label">CUIT</label>
                <input id="txtCuitEst" class="form-control" maxlength="@IntercambioTxtCampos.Cuit" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Condicion IVA</label>
                <div class="rp-select-plus">
                    <select id="cmbCondicionIvaEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" data-config-nombre="Condiciones IVA" data-config-controller="CondicionesIva"><i class="fa fa-plus"></i></button>
                </div>
            </div>

            <div class="col-md-12">
                <div class="rp-iva-card" id="rpIvaCardEst">
                    <div class="rp-iva-card-icon">
                        <i class="fa fa-percent"></i>
                    </div>
                    <div class="rp-iva-card-text">
                        <p class="rp-iva-card-title">Impuesto IVA</p>
                        <p class="rp-iva-card-desc">Indica si este establecimiento discrimina o aplica IVA en sus operaciones.</p>
                    </div>
                    <div class="rp-iva-card-toggle">
                        <span class="rp-iva-card-status" id="rpIvaCardStatusEst">No aplica</span>
                        <label class="rp-switch" title="Aplica IVA">
                            <input type="checkbox" id="chkImpuestoIvaEst" class="rp-switch-input" />
                            <span class="rp-switch-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Provincia</label>
                <div class="rp-select-plus">
                    <select id="cmbProvinciaEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" data-config-nombre="Provincias" data-config-controller="Provincias"><i class="fa fa-plus"></i></button>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Partido</label>
                <div class="rp-select-plus">
                    <select id="cmbPartidoEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar partido"
                            data-config-nombre="Partidos" data-config-controller="Partidos"
                            data-config-combo-nombre="Provincias" data-config-combo-controller="Provincias"
                            data-config-combo-label="Provincia">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label">Codigo partido</label>
                <input id="txtCodigoPartidoEst" class="form-control" readonly disabled autocomplete="off" placeholder="-" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Localidad</label>
                <div class="rp-select-plus">
                    <select id="cmbLocalidadEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar localidad"
                            data-config-nombre="Localidades" data-config-controller="Localidades"
                            data-config-combo-nombre="Provincias" data-config-combo-controller="Provincias"
                            data-config-combo-label="Provincia">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label">Codigo localidad</label>
                <input id="txtCodigoLocalidadEst" class="form-control" readonly disabled autocomplete="off" placeholder="-" />
            </div>

            <div class="col-md-5">
                <label class="form-label">Calle</label>
                <input id="txtCalleEst" class="form-control" maxlength="@IntercambioTxtCampos.Calle" autocomplete="section-domicilio street-address" />
            </div>

            <div class="col-md-7">
                <label class="form-label">Descripcion</label>
                <input id="txtDescripcionEst" class="form-control" maxlength="200"
                       placeholder="Entrecalles, referencias, etc."
                       title="Entrecalles, referencias u otras indicaciones del domicilio" />
            </div>

            <div class="w-100"></div>

            <div class="col-md-2">
                <label class="form-label">Numero</label>
                <input id="txtNumeroEst" class="form-control" maxlength="@IntercambioTxtCampos.Numero" autocomplete="section-domicilio address-line1" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Piso / Depto</label>
                <input id="txtPisoDeptoEst" class="form-control" maxlength="@IntercambioTxtCampos.Adicional" autocomplete="section-domicilio address-line2" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Codigo postal</label>
                <input id="txtCodPostalEst" class="form-control" maxlength="@IntercambioTxtCampos.CodigoPostal" autocomplete="section-domicilio postal-code" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Tipo de generador</label>
                <div class="rp-select-plus">
                    <select id="cmbTipoGeneradorEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar tipo de generador"
                            data-config-nombre="Tipos de Generador" data-config-controller="ClientesTiposGenerador">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label" title="Ej. carpintero, odontólogo, tatuador">Actividad</label>
                <div class="rp-select-plus">
                    <select id="cmbActividadEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar actividad"
                            data-config-nombre="Actividades de Establecimientos" data-config-controller="ClientesActividades">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Estado comercial</label>
                <div class="rp-select-plus">
                    <select id="cmbEstadoEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar estado"
                            data-config-nombre="Estados de clientes" data-config-controller="ClientesEstados">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Calificacion</label>
                <div class="rp-select-plus">
                    <select id="cmbCalificacionEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar calificacion"
                            data-config-nombre="Calificaciones de clientes" data-config-controller="ClientesCalificaciones">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Motivo</label>
                <div class="rp-select-plus">
                    <select id="cmbMotivoEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar motivo"
                            data-config-nombre="Motivos de clientes" data-config-controller="ClientesMotivos">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>
            <div class="col-12" id="wrapMotivoDetalleEst" hidden>
                <label class="form-label">Detalle del motivo</label>
                <textarea id="txtMotivoDetalleEst" class="form-control" rows="2" maxlength="500"></textarea>
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha inicio</label>
                <input type="date" id="txtFechaInicioEst" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Licencia desde</label>
                <input type="date" id="txtFechaLicenciaDesdeEst" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Licencia hasta</label>
                <input type="date" id="txtFechaLicenciaHastaEst" class="form-control" />
            </div>
            <div class="col-12">
                <small class="text-muted">
                    Si hoy cae entre las fechas de licencia, este establecimiento cuenta en <strong>Licencia</strong>
                    (aunque el estado comercial siga en Activo). Las alertas avisan licencias que vencen en los proximos 30 dias.
                </small>
            </div>

            <div class="col-12 rp-recoleccion-block">
                <div class="rp-recoleccion-block-title">
                    <i class="fa fa-truck"></i> Recoleccion
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="rp-visitas">
                            <div class="rp-visitas-head">
                                <div class="rp-visitas-title"><i class="fa fa-map-marker"></i> Visitas del recorrido</div>
                                <div class="rp-visitas-sub">Varios días o varias semanas. Cada una entra en la hoja de ruta.</div>
                            </div>
                            <div class="rp-visita-cols" aria-hidden="true">
                                <span></span>
                                <span>Día</span>
                                <span>Semana</span>
                                <span>Unidad</span>
                                <span>Nº</span>
                                <span></span>
                            </div>
                            <div id="listaVisitasEst" class="rp-visitas-list">
                                <div class="rp-visita-row" data-visita-principal="1">
                                    <div class="rp-visita-index" aria-hidden="true">1</div>
                                    <div class="rp-visita-field">
                                        <div class="rp-select-plus">
                                            <select id="cmbDiaEst" class="form-control"></select>
                                            <button type="button" class="rp-btn-plus" data-config-nombre="Dias" data-config-controller="Dias"><i class="fa fa-plus"></i></button>
                                        </div>
                                    </div>
                                    <div class="rp-visita-field">
                                        <div class="rp-select-plus">
                                            <select id="cmbSemanaEst" class="form-control"></select>
                                            <button type="button" class="rp-btn-plus" data-config-nombre="Semanas" data-config-controller="Semanas"><i class="fa fa-plus"></i></button>
                                        </div>
                                    </div>
                                    <div class="rp-visita-field">
                                        <div class="rp-select-plus">
                                            <select id="cmbCamionEst" class="form-control"></select>
                                            <button type="button" class="rp-btn-plus" data-config-nombre="Camiones" data-config-controller="Camiones" title="Agregar camion"><i class="fa fa-plus"></i></button>
                                        </div>
                                    </div>
                                    <div class="rp-visita-field">
                                        <input id="txtOrdenRecorridoEst" class="form-control" type="number" min="0" step="1" placeholder="Auto" autocomplete="one-time-code" title="Posición en la hoja. Vacío = al final." />
                                    </div>
                                    <div class="rp-visita-actions"></div>
                                </div>
                            </div>
                            <button type="button" class="rp-visita-add" id="btnAgregarVisitaEst">
                                <i class="fa fa-plus"></i> Agregar otra visita
                            </button>
                            <div class="rp-visitas-note">Nº vacío se asigna al final de esa hoja. Para sacar la primera visita, vaciá día y semana.</div>
                        </div>
                        <div id="avisoRecoleccionEst" class="rp-recoleccion-warn">
                            Sin al menos un día y una semana, este establecimiento no entra en recorridos ni en la hoja de ruta.
                        </div>
                        <div id="avisoOrdenRecorridoEst" class="rp-orden-aviso" hidden>
                            <div class="rp-orden-aviso-text"></div>
                            <div class="rp-orden-aviso-actions">
                                <button type="button" class="btn btn-warning" data-orden-aviso="si">Sí, reemplazar y desplazar</button>
                                <button type="button" class="btn btn-outline-light" data-orden-aviso="no">No</button>
                            </div>
                            <div class="rp-orden-aviso-estado" hidden></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Kilos</label>
                        <input id="txtKilosEst" class="form-control" type="number" min="0" step="0.01" autocomplete="one-time-code" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Dias y horarios</label>
                        <textarea id="txtDiasHorariosEst" class="form-control cg-dias-horarios-text" rows="4"
                                  maxlength="1000"></textarea>
                    </div>
                </div>
            </div>
        </form>

        <div class="rp-auditoria d-none mt-3" id="infoAuditoriaEst">
            <div id="infoRegistroEst"></div>
            <div id="infoModificacionEst"></div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabContactosEst">
        <div id="sectionContactosEst" class="rp-sub-page rp-section-disabled">
            <div class="rp-sub-hero">
                <div>
                    <div class="text-muted small">Establecimiento</div>
                    <div class="rp-sub-hero-name" id="contactoEstNombre">Nuevo</div>
                    <div class="rp-sub-hero-hint" id="contactoEstHint">
                        <i class="fa fa-info-circle"></i> Guardá el establecimiento para administrar contactos.
                    </div>
                </div>
                <div class="rp-kpi-card-mini">
                    <span>Contactos</span>
                    <strong id="contactoEstCantidad">0</strong>
                </div>
            </div>
            <div class="rp-sub-layout">
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-list"></i> Listado
                        <small>Selecciona para editar</small>
                    </div>
                    <div class="rp-sub-panel-body">
                        <div id="listaContactosEst" class="rp-sub-list">
                            <div class="rp-sub-empty">
                                <i class="fa fa-address-book-o"></i>
                                <p>Guarda el establecimiento para ver contactos.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-user-plus"></i>
                        <span id="contactoEstFormTitulo">Nuevo contacto</span>
                    </div>
                    <div class="rp-sub-panel-body rp-sub-form">
                        <input type="hidden" id="txtContactoEstId" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label"><i class="fa fa-user"></i> Nombre</label>
                                <input id="txtContactoEstNombre" class="form-control" maxlength="100" placeholder="Nombre y apellido" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-briefcase"></i> Puesto</label>
                                <input id="txtContactoEstPuesto" class="form-control" maxlength="100" placeholder="Ej. Encargado" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-phone"></i> Telefono</label>
                                <input id="txtContactoEstTelefono" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-phone"></i> Telefono alternativo</label>
                                <input id="txtContactoEstTelefonoAlt" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-envelope-o"></i> Email</label>
                                <input id="txtContactoEstEmail" class="form-control" type="email" maxlength="100" />
                            </div>
                        </div>
                        <div class="rp-form-actions">
                            <button type="button" id="btnGuardarContactoEst" class="btn btn-primary btn-sm" onclick="guardarContactoEstablecimiento()">
                                <i class="fa fa-check"></i> Guardar contacto
                            </button>
                            <button type="button" id="btnNuevoContactoEst" class="btn btn-outline-light btn-sm" onclick="nuevoContactoEstablecimiento()">
                                <i class="fa fa-plus"></i> Nuevo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabTercerosEst">
        <div id="sectionTercerosEst" class="rp-sub-page rp-section-disabled">
            <div class="rp-sub-hero">
                <div>
                    <div class="text-muted small">Establecimiento</div>
                    <div class="rp-sub-hero-name" id="terceroEstNombre">Nuevo</div>
                    <div class="rp-sub-hero-hint" id="terceroEstHint">
                        <i class="fa fa-info-circle"></i> Guardá el establecimiento para cargar quién paga por este local.
                    </div>
                </div>
                <div class="rp-kpi-card-mini">
                    <span>Pagadores</span>
                    <strong id="terceroEstCantidad">0</strong>
                </div>
            </div>
            <div id="terceroEstAnalisis" class="est-tercero-analisis" hidden></div>
            <div class="rp-sub-layout">
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-list"></i> Listado
                        <small>Seleccioná para editar</small>
                    </div>
                    <div class="rp-sub-panel-body">
                        <div id="listaTercerosEst" class="rp-sub-list">
                            <div class="rp-sub-empty">
                                <i class="fa fa-exchange"></i>
                                <p>Guardá el establecimiento para ver pagadores.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-user-plus"></i>
                        <span id="terceroEstFormTitulo">Nuevo pagador</span>
                    </div>
                    <div class="rp-sub-panel-body rp-sub-form">
                        <input type="hidden" id="txtTerceroEstId" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label"><i class="fa fa-user"></i> Nombre</label>
                                <input id="txtTerceroEstNombre" class="form-control" maxlength="100" placeholder="Persona o razón social" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-id-card"></i> CUIT</label>
                                <input id="txtTerceroEstCuit" class="form-control" maxlength="20" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-phone"></i> Teléfono</label>
                                <input id="txtTerceroEstTelefono" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-envelope-o"></i> Email</label>
                                <input id="txtTerceroEstEmail" class="form-control" type="email" maxlength="100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-university"></i> Banco</label>
                                <input id="txtTerceroEstBanco" class="form-control" maxlength="80" placeholder="Banco desde el que transfiere" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-barcode"></i> CBU / alias</label>
                                <input id="txtTerceroEstCbu" class="form-control" maxlength="40" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-toggle-on"></i> Estado</label>
                                <label class="est-tercero-activo" for="chkTerceroEstActivo">
                                    <input type="checkbox" id="chkTerceroEstActivo" class="est-tercero-activo-input" checked />
                                    <span class="est-tercero-activo-ui">
                                        <span class="est-tercero-activo-track" aria-hidden="true"><span></span></span>
                                        <span class="est-tercero-activo-copy">
                                            <strong>Activo</strong>
                                            <small>Aparece como pagador en cobros</small>
                                        </span>
                                    </span>
                                </label>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Observaciones</label>
                                <textarea id="txtTerceroEstObs" class="form-control" rows="2" maxlength="500"></textarea>
                            </div>
                        </div>
                        <div class="rp-form-actions">
                            <button type="button" id="btnGuardarTerceroEst" class="btn btn-primary btn-sm" onclick="guardarTerceroEstablecimiento()">
                                <i class="fa fa-check"></i> Guardar pagador
                            </button>
                            <button type="button" id="btnNuevoTerceroEst" class="btn btn-outline-light btn-sm" onclick="nuevoTerceroEstablecimiento()">
                                <i class="fa fa-plus"></i> Nuevo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabContratosEst">
        <div id="sectionContratosEst" class="rp-sub-page rp-section-disabled cg-contratos-tab-shell">
            <div class="cg-ctr-inline-hero">
                <div class="cg-ctr-inline-hero-main">
                    <div class="cg-ctr-inline-kicker">Establecimiento</div>
                    <div class="cg-ctr-inline-title" id="contratoEstNombre">Nuevo</div>
                    <div class="cg-ctr-inline-meta" id="contratoEstHint">
                        <i class="fa fa-info-circle"></i> Guardá el establecimiento para ver sus contratos.
                    </div>
                    <div id="contratoEstActChip" class="cg-ctr-act-chip d-none"></div>
                </div>
                <div class="cg-ctr-inline-stats">
                    <div class="cg-ctr-stat">
                        <span>Total</span>
                        <strong id="contratoEstCantidad">0</strong>
                    </div>
                    <div class="cg-ctr-stat cg-ctr-stat--ok">
                        <span>Vigentes</span>
                        <strong id="contratoEstVigentes">0</strong>
                    </div>
                    <div class="cg-ctr-stat cg-ctr-stat--off">
                        <span>Vencidos</span>
                        <strong id="contratoEstVencidos">0</strong>
                    </div>
                    <button type="button" id="btnNuevoContratoEst" class="cg-btn cg-btn--success cg-btn--sm" onclick="abrirNuevoContratoEstCg()">
                        <i class="fa fa-plus"></i> Nuevo
                    </button>
                </div>
            </div>
            <div id="listaContratosEst" class="cg-contratos-est-inline"></div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabProductosEst">
        <div id="sectionProductosEst" class="rp-sub-page rp-section-disabled">
            <div class="rp-sub-hero">
                <div>
                    <div class="text-muted small">Establecimiento</div>
                    <div class="rp-sub-hero-name" id="productoEstNombre">Nuevo</div>
                    <div class="rp-sub-hero-hint" id="productoEstHint">
                        <i class="fa fa-info-circle"></i> Guardá el establecimiento para asignar productos.
                    </div>
                </div>
                <div class="rp-kpi-card-mini">
                    <span>Productos</span>
                    <strong id="productoEstCantidad">0</strong>
                </div>
            </div>
            <div class="rp-sub-layout">
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-list"></i> Listado
                        <small>Seleccioná para editar</small>
                    </div>
                    <div class="rp-sub-panel-body">
                        <div id="listaProductosEst" class="rp-sub-list">
                            <div class="rp-sub-empty">
                                <i class="fa fa-cube"></i>
                                <p>Guardá el establecimiento para ver productos.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-plus-circle"></i>
                        <span id="productoEstFormTitulo">Agregar producto</span>
                    </div>
                    <div class="rp-sub-panel-body rp-sub-form">
                        <input type="hidden" id="txtProductoEstId" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label"><i class="fa fa-cube"></i> Producto</label>
                                <select id="cmbProductoEst" class="form-control"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fa fa-sort-numeric-asc"></i> Cantidad</label>
                                <input id="txtCantidadEst" type="text" class="form-control Inputmiles" inputmode="decimal" autocomplete="off" placeholder="0" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fa fa-tags"></i> Lista de precios</label>
                                <select id="cmbListaPrecioProdEst" class="form-control"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fa fa-usd"></i> Precio</label>
                                <input id="txtPrecioVentaEst" type="text" class="form-control Inputmiles" inputmode="decimal" autocomplete="off" placeholder="0,00" />
                                <div class="form-text text-muted">Se completa al elegir la lista; podés editarlo. Podés cargar el mismo producto con otra lista.</div>
                            </div>
                        </div>
                        <div class="rp-form-actions">
                            <button type="button" id="btnGuardarProductoEst" class="btn btn-primary btn-sm" onclick="guardarProductoEstablecimiento()">
                                <i class="fa fa-check"></i> Guardar producto
                            </button>
                            <button type="button" id="btnNuevoProductoEst" class="btn btn-outline-light btn-sm" onclick="nuevoProductoEstablecimiento()">
                                <i class="fa fa-plus"></i> Nuevo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (incluirManifiestos)
    {
        <div class="tab-pane fade" id="tabManifiestosEst">
            <div class="cg-list-panel" data-cg-list="manifiestos">
                <div class="cg-list-toolbar">
                    <div class="cg-list-toolbar-info">
                        <h6 class="cg-list-title"><i class="fa fa-file-text-o"></i> Manifiestos y certificados</h6>
                        <small class="text-muted">Historial de este establecimiento</small>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" id="btnRefreshManifiestosCg" class="cg-btn cg-btn--ghost cg-btn--sm">
                            <i class="fa fa-refresh"></i> Actualizar
                        </button>
                    </div>
                </div>
                <div class="cg-mf-split">
                    <section class="cg-mf-col cg-mf-col--manif">
                        <header class="cg-mf-col-head">
                            <span class="cg-mf-badge cg-mf-badge--manif">Manifiestos</span>
                            <strong id="cgMfManifCount">0</strong>
                        </header>
                        <div id="cgTabManifiestosList" class="cg-manifiestos-list">
                            <div class="cg-hub-stock-empty">Sin manifiestos registrados.</div>
                        </div>
                    </section>
                    <section class="cg-mf-col cg-mf-col--cert">
                        <header class="cg-mf-col-head">
                            <span class="cg-mf-badge cg-mf-badge--cert">Certificados</span>
                            <strong id="cgMfCertCount">0</strong>
                        </header>
                        <div id="cgTabCertificadosList" class="cg-manifiestos-list">
                            <div class="cg-hub-stock-empty">Sin certificados registrados.</div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    }

    @if (incluirStock)
    {
        <div class="tab-pane fade" id="tabStockEst">
            <div class="cg-est-hub-wrap">
                <div class="cg-est-hub-hint text-muted small mb-2">
                    Mismo control que en el cliente, filtrado a este establecimiento (entregas, visita y abonos propios).
                    Los cobros de cuenta corriente del cliente siguen en la solapa Cuenta corriente.
                </div>
                <div id="cgEstHubMount" class="cg-est-hub-mount">
                    <div class="cg-hub-stock-empty">Seleccioná o guardá el establecimiento para ver el control.</div>
                </div>
            </div>
        </div>
    }

</div>
