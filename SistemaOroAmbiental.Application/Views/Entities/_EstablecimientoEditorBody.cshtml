@{
    var incluirStock = ViewData["IncluirStockEst"] as bool? == true;
}

<div id="errorCamposEst" class="rp-error-panel d-none mb-2">
    <div class="rp-error-icon"><i class="fa fa-exclamation-triangle"></i></div>
    <div class="rp-error-content">
        <div class="rp-error-title">No se pudo guardar</div>
        <div class="rp-error-message"></div>
    </div>
    <button type="button" class="rp-error-close" onclick="cerrarErrorCamposEst()">
        <i class="fa fa-times"></i>
    </button>
</div>

<div class="rp-tabs-shell">
    <ul class="nav rp-tabs-modern">
        <li class="nav-item">
            <button class="nav-link active" id="tabBtnDatosEst" data-bs-toggle="tab" data-bs-target="#tabDatosEst" type="button">
                <i class="fa fa-building"></i><span>Datos</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tabBtnContactosEst" data-bs-toggle="tab" data-bs-target="#tabContactosEst" type="button">
                <i class="fa fa-address-book"></i><span>Contactos</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="tabBtnProductosEst" data-bs-toggle="tab" data-bs-target="#tabProductosEst" type="button">
                <i class="fa fa-cube"></i><span>Productos</span>
            </button>
        </li>
        @if (incluirStock)
        {
            <li class="nav-item">
                <button class="nav-link" id="tabBtnStockEst" data-bs-toggle="tab" data-bs-target="#tabStockEst" type="button">
                    <i class="fa fa-calendar-check-o"></i><span>Control de pagos y stock</span>
                </button>
            </li>
        }
    </ul>
</div>

<div class="tab-content mt-3">

    <div class="tab-pane fade show active" id="tabDatosEst">
        <form class="row g-3">
            <input type="text" id="txtIdEst" hidden />

            <div class="col-md-6" id="wrapClienteEst">
                <label class="form-label" for="cmbClienteEst">Cliente</label>
                <div class="rp-select-plus">
                    <select id="cmbClienteEst" class="form-control" required></select>
                    <button type="button"
                            id="btnAgregarClienteEst"
                            class="rp-btn-plus"
                            title="Agregar cliente">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
                <div class="form-text text-muted">No requiere contrato. Si no hay clientes, usa el boton +.</div>
                <div class="invalid-feedback">Campo obligatorio</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Nombre establecimiento</label>
                <input id="txtNombreEst" class="form-control" required maxlength="100" />
                <div class="invalid-feedback">Campo obligatorio</div>
            </div>

            <div class="col-md-3">
                <label class="form-label">Id establecimiento</label>
                <input id="txtIdEstablecimientoClienteEst" class="form-control" maxlength="8" />
            </div>

            <div class="col-md-4">
                <label class="form-label">CUIT</label>
                <input id="txtCuitEst" class="form-control" maxlength="20" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Condicion IVA</label>
                <div class="rp-select-plus">
                    <select id="cmbCondicionIvaEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" data-config-nombre="Condiciones IVA" data-config-controller="CondicionesIva"><i class="fa fa-plus"></i></button>
                </div>
            </div>

            <div class="col-md-12">
                <div class="rp-iva-card" id="rpIvaCardEst">
                    <div class="rp-iva-card-icon">
                        <i class="fa fa-percent"></i>
                    </div>
                    <div class="rp-iva-card-text">
                        <p class="rp-iva-card-title">Impuesto IVA</p>
                        <p class="rp-iva-card-desc">Indica si este establecimiento discrimina o aplica IVA en sus operaciones.</p>
                    </div>
                    <div class="rp-iva-card-toggle">
                        <span class="rp-iva-card-status" id="rpIvaCardStatusEst">No aplica</span>
                        <label class="rp-switch" title="Aplica IVA">
                            <input type="checkbox" id="chkImpuestoIvaEst" class="rp-switch-input" />
                            <span class="rp-switch-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Provincia</label>
                <div class="rp-select-plus">
                    <select id="cmbProvinciaEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" data-config-nombre="Provincias" data-config-controller="Provincias"><i class="fa fa-plus"></i></button>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Partido</label>
                <div class="rp-select-plus">
                    <select id="cmbPartidoEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar partido"
                            data-config-nombre="Partidos" data-config-controller="Partidos"
                            data-config-combo-nombre="Provincias" data-config-combo-controller="Provincias"
                            data-config-combo-label="Provincia">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label">Codigo partido</label>
                <input id="txtCodigoPartidoEst" class="form-control" readonly disabled autocomplete="off" placeholder="-" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Localidad</label>
                <div class="rp-select-plus">
                    <select id="cmbLocalidadEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar localidad"
                            data-config-nombre="Localidades" data-config-controller="Localidades"
                            data-config-combo-nombre="Provincias" data-config-combo-controller="Provincias"
                            data-config-combo-label="Provincia">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label">Codigo localidad</label>
                <input id="txtCodigoLocalidadEst" class="form-control" readonly disabled autocomplete="off" placeholder="-" />
            </div>

            <div class="col-md-5">
                <label class="form-label">Calle</label>
                <input id="txtCalleEst" class="form-control" maxlength="40" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Numero</label>
                <input id="txtNumeroEst" class="form-control" maxlength="13" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Piso / Depto</label>
                <input id="txtPisoDeptoEst" class="form-control" maxlength="50" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Codigo postal</label>
                <input id="txtCodPostalEst" class="form-control" maxlength="10" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Tipo de generador</label>
                <div class="rp-select-plus">
                    <select id="cmbTipoGeneradorEst" class="form-control"></select>
                    <button type="button" class="rp-btn-plus" title="Agregar tipo de generador"
                            data-config-nombre="Tipos de Generador" data-config-controller="ClientesTiposGenerador">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="col-12 rp-recoleccion-block">
                <div class="rp-recoleccion-block-title">
                    <i class="fa fa-truck"></i> Recoleccion
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Dia recoleccion</label>
                        <div class="rp-select-plus">
                            <select id="cmbDiaEst" class="form-control" required></select>
                            <button type="button" class="rp-btn-plus" data-config-nombre="Dias" data-config-controller="Dias"><i class="fa fa-plus"></i></button>
                        </div>
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Semana recoleccion</label>
                        <div class="rp-select-plus">
                            <select id="cmbSemanaEst" class="form-control" required></select>
                            <button type="button" class="rp-btn-plus" data-config-nombre="Semanas" data-config-controller="Semanas"><i class="fa fa-plus"></i></button>
                        </div>
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Unidad / Camion</label>
                        <div class="rp-select-plus">
                            <select id="cmbCamionEst" class="form-control"></select>
                            <button type="button" class="rp-btn-plus" data-config-nombre="Camiones" data-config-controller="Camiones" title="Agregar camion"><i class="fa fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Dias y horarios</label>
                        <textarea id="txtDiasHorariosEst" class="form-control cg-dias-horarios-text" rows="4"
                                  maxlength="1000"></textarea>
                    </div>
                </div>
            </div>
        </form>

        <div class="rp-auditoria d-none mt-3" id="infoAuditoriaEst">
            <div id="infoRegistroEst"></div>
            <div id="infoModificacionEst"></div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabContactosEst">
        <div id="sectionContactosEst" class="rp-sub-page rp-section-disabled">
            <div class="rp-sub-hero">
                <div>
                    <div class="text-muted small">Establecimiento</div>
                    <div class="rp-sub-hero-name" id="contactoEstNombre">Nuevo</div>
                    <div class="rp-sub-hero-hint" id="contactoEstHint">
                        <i class="fa fa-info-circle"></i> Guardá el establecimiento para administrar contactos.
                    </div>
                </div>
                <div class="rp-kpi-card-mini">
                    <span>Contactos</span>
                    <strong id="contactoEstCantidad">0</strong>
                </div>
            </div>
            <div class="rp-sub-layout">
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-list"></i> Listado
                        <small>Selecciona para editar</small>
                    </div>
                    <div class="rp-sub-panel-body">
                        <div id="listaContactosEst" class="rp-sub-list">
                            <div class="rp-sub-empty">
                                <i class="fa fa-address-book-o"></i>
                                <p>Guarda el establecimiento para ver contactos.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-user-plus"></i>
                        <span id="contactoEstFormTitulo">Nuevo contacto</span>
                    </div>
                    <div class="rp-sub-panel-body rp-sub-form">
                        <input type="hidden" id="txtContactoEstId" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label"><i class="fa fa-user"></i> Nombre</label>
                                <input id="txtContactoEstNombre" class="form-control" maxlength="100" placeholder="Nombre y apellido" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-briefcase"></i> Puesto</label>
                                <input id="txtContactoEstPuesto" class="form-control" maxlength="100" placeholder="Ej. Encargado" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-phone"></i> Telefono</label>
                                <input id="txtContactoEstTelefono" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-phone"></i> Telefono alternativo</label>
                                <input id="txtContactoEstTelefonoAlt" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fa fa-envelope-o"></i> Email</label>
                                <input id="txtContactoEstEmail" class="form-control" type="email" maxlength="100" />
                            </div>
                        </div>
                        <div class="rp-form-actions">
                            <button type="button" id="btnGuardarContactoEst" class="btn btn-primary btn-sm" onclick="guardarContactoEstablecimiento()">
                                <i class="fa fa-check"></i> Guardar contacto
                            </button>
                            <button type="button" id="btnNuevoContactoEst" class="btn btn-outline-light btn-sm" onclick="nuevoContactoEstablecimiento()">
                                <i class="fa fa-plus"></i> Nuevo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabProductosEst">
        <div id="sectionProductosEst" class="rp-sub-page rp-section-disabled">
            <div class="rp-sub-hero">
                <div>
                    <div class="text-muted small">Establecimiento</div>
                    <div class="rp-sub-hero-name" id="productoEstNombre">Nuevo</div>
                    <div class="rp-sub-hero-hint" id="productoEstHint">
                        <i class="fa fa-info-circle"></i> Guardá el establecimiento para asignar productos.
                    </div>
                </div>
                <div class="rp-kpi-card-mini">
                    <span>Productos</span>
                    <strong id="productoEstCantidad">0</strong>
                </div>
            </div>
            <div class="rp-sub-layout">
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-list"></i> Listado
                        <small>Seleccioná para editar</small>
                    </div>
                    <div class="rp-sub-panel-body">
                        <div id="listaProductosEst" class="rp-sub-list">
                            <div class="rp-sub-empty">
                                <i class="fa fa-cube"></i>
                                <p>Guardá el establecimiento para ver productos.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="rp-sub-panel">
                    <div class="rp-sub-panel-head">
                        <i class="fa fa-plus-circle"></i>
                        <span id="productoEstFormTitulo">Agregar producto</span>
                    </div>
                    <div class="rp-sub-panel-body rp-sub-form">
                        <input type="hidden" id="txtProductoEstId" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label"><i class="fa fa-cube"></i> Producto</label>
                                <select id="cmbProductoEst" class="form-control"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fa fa-sort-numeric-asc"></i> Cantidad</label>
                                <input id="txtCantidadEst" type="text" class="form-control Inputmiles" inputmode="decimal" autocomplete="off" placeholder="0" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fa fa-tags"></i> Lista de precios</label>
                                <select id="cmbListaPrecioProdEst" class="form-control"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="fa fa-usd"></i> Precio</label>
                                <input id="txtPrecioVentaEst" type="text" class="form-control Inputmiles" inputmode="decimal" autocomplete="off" placeholder="0,00" />
                                <div class="form-text text-muted">Se completa al elegir la lista; podés editarlo. Podés cargar el mismo producto con otra lista.</div>
                            </div>
                        </div>
                        <div class="rp-form-actions">
                            <button type="button" id="btnGuardarProductoEst" class="btn btn-primary btn-sm" onclick="guardarProductoEstablecimiento()">
                                <i class="fa fa-check"></i> Guardar producto
                            </button>
                            <button type="button" id="btnNuevoProductoEst" class="btn btn-outline-light btn-sm" onclick="nuevoProductoEstablecimiento()">
                                <i class="fa fa-plus"></i> Nuevo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (incluirStock)
    {
        <div class="tab-pane fade" id="tabStockEst">
            <div class="cg-est-hub-wrap">
                <div class="cg-est-hub-hint text-muted small mb-2">
                    Mismo control que en el cliente, filtrado a este establecimiento (entregas, visita y abonos propios).
                    Los cobros de cuenta corriente del cliente siguen en la solapa Cuenta corriente.
                </div>
                <div id="cgEstHubMount" class="cg-est-hub-mount">
                    <div class="cg-hub-stock-empty">Seleccioná o guardá el establecimiento para ver el control.</div>
                </div>
            </div>
        </div>
    }

</div>
