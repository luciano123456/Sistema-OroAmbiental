@{
    Layout = "_LayoutModulo";
    ViewData["Title"] = "Recorridos";
}

@section Estilos {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link href="~/css/Productora.css?v=7.2" rel="stylesheet" />
    <link href="~/css/disenopantallas.css?v=8.1" rel="stylesheet" />
    <link href="~/css/M_Generico.css?v=7.2" rel="stylesheet" />
    <link href="~/css/Camiones.css?v=6.5" rel="stylesheet" />
    <link href="~/css/Recorridos.css?v=10.1" rel="stylesheet" />
}

<div class="rec-page rec-sin-unidad">

    <div class="cc-header shadow-lg rounded-4 p-4 mb-3">
        <div class="d-flex align-items-center gap-3 flex-wrap w-100">
            <span class="cc-badge rec-badge">
                <i class="fa fa-map-signs"></i>
            </span>
            <div class="flex-grow-1 min-w-0">
                <h2 class="m-0 fw-800">Recorridos</h2>
            </div>

            <div class="rec-toolbar ms-auto">
                <div class="rec-field rec-field-unidad rec-field-unidad--pendiente" id="recFieldUnidad">
                    <label class="form-label" for="selCamion">
                        Unidad
                        <span class="rec-unidad-req">Requerido</span>
                    </label>
                    <div class="rp-select-plus">
                        <select id="selCamion" class="form-control rec-select"></select>
                        <button type="button" class="rp-btn-plus" id="btnNuevoCamionRec" title="Agregar unidad">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="rec-field rec-field-search">
                    <label class="form-label" for="txtBuscarRecorrido">Buscar</label>
                    <div class="rec-search-wrap">
                        <span class="rec-search-icon"><i class="fa fa-search"></i></span>
                        <input type="text" id="txtBuscarRecorrido" class="form-control rec-input"
                               placeholder="Cliente, zona o recorrido..." autocomplete="off" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="panelBusqueda" class="card-glass rec-card mb-3 d-none">
        <div class="rec-card-head">
            <div>
                <h5 class="rec-card-title"><i class="fa fa-search me-2"></i>Resultados</h5>
            </div>
            <button type="button" class="btn btn-sm btn-outline-light" id="btnCerrarBusqueda">
                <i class="fa fa-times"></i>
            </button>
        </div>
        <div class="rec-table-wrap">
            <table class="rec-table" id="tblBusqueda">
                <thead>
                    <tr>
                        <th>Recorrido</th>
                        <th>Unidad</th>
                        <th>Zona</th>
                        <th>Pos.</th>
                        <th>Cliente</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div class="card-glass rec-card mb-3 rec-card--sin-unidad" id="recCardRutas">
        <div class="rec-card-head">
            <div>
                <h5 class="rec-card-title"><i class="fa fa-list-ul me-2"></i>Rutas de la unidad</h5>
                <small class="text-muted-cc" id="lblRutasHint">
                    <span class="rec-hint-pendiente"><i class="fa fa-arrow-circle-up"></i> Elegi una unidad arriba para continuar</span>
                </small>
            </div>
            <div class="rec-catalogos-shortcuts">
                <span class="rec-shortcut-label">Catalogos:</span>
                <button type="button" class="btn btn-sm btn-outline-light rec-btn-shortcut"
                        data-config-nombre="Semanas" data-config-controller="Semanas">
                    <i class="fa fa-plus"></i> Semanas
                </button>
                <button type="button" class="btn btn-sm btn-outline-light rec-btn-shortcut"
                        data-config-nombre="Dias" data-config-controller="Dias">
                    <i class="fa fa-plus"></i> Dias
                </button>
            </div>
        </div>

        <div class="rec-filtros row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label" for="selRecorridoRapido">Ir al recorrido</label>
                <select id="selRecorridoRapido" class="form-control rec-select" disabled></select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="selFiltroSemana">Filtrar semana</label>
                <select id="selFiltroSemana" class="form-control rec-select">
                    <option value="">Todas las semanas</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="selFiltroDia">Filtrar dia</label>
                <select id="selFiltroDia" class="form-control rec-select">
                    <option value="">Todos los dias</option>
                </select>
            </div>
        </div>

        <div id="listaRutas" class="rec-rutas-list">
            <div class="rec-unidad-prompt">
                <div class="rec-unidad-prompt-glow"></div>
                <span class="rec-unidad-prompt-icon"><i class="fa fa-truck"></i></span>
                <p class="rec-unidad-prompt-step">Paso 1</p>
                <h6 class="rec-unidad-prompt-title">Selecciona una unidad</h6>
                <p class="rec-unidad-prompt-text">
                    Aca vas a ver las rutas por semana y dia. Elegi la unidad de recoleccion en el selector de arriba para empezar.
                </p>
                <button type="button" class="btn btn-success rec-btn-unidad-prompt">
                    <i class="fa fa-hand-pointer-o me-1"></i> Elegir unidad
                </button>
            </div>
        </div>
    </div>

    <div class="card-glass rec-card" id="panelClientes">
        <div class="rec-card-head">
            <div>
                <h5 class="rec-card-title"><i class="fa fa-users me-2"></i>Clientes del recorrido</h5>
                <small class="text-muted-cc" id="lblRecorridoSeleccionado">Elegi un recorrido de la lista</small>
            </div>
            <div class="d-flex rec-actions">
                <button type="button" class="rec-action rec-action--magic d-none" id="btnTraerProgramadosRec" disabled>
                    <i class="fa fa-magic"></i> Traer programados
                </button>
                <button type="button" class="rec-action rec-action--print" id="btnHojaRutaRecorrido" disabled>
                    <i class="fa fa-print"></i> Hoja de ruta
                </button>
                <button type="button" class="rec-action rec-action--txt" id="btnTxtMesRecorrido" disabled
                        title="Exportar TXT de todas las semanas y clientes de la unidad">
                    <i class="fa fa-calendar"></i> TXT mes
                </button>
                <button type="button" class="rec-action rec-action--txt" id="btnTxtSeleccionarRecorrido" disabled
                        title="Elegir clientes de esta hoja para exportar TXT">
                    <i class="fa fa-check-square-o"></i> Seleccionar TXT
                </button>
                <div class="rec-txt-sel-bar d-none" id="barTxtSeleccionRecorrido">
                    <span class="rec-txt-sel-count" id="lblTxtSeleccionRecorrido">0 seleccionados</span>
                    <button type="button" class="rec-action rec-action--ghost" id="btnTxtSelTodosRecorrido">
                        <i class="fa fa-check-square-o"></i> Todos
                    </button>
                    <button type="button" class="rec-action rec-action--txt" id="btnTxtSelExportarRecorrido" disabled>
                        <i class="fa fa-download"></i> Exportar TXT
                    </button>
                    <button type="button" class="rec-action rec-action--cancel" id="btnTxtSelCancelarRecorrido">
                        <i class="fa fa-times"></i> Cancelar
                    </button>
                </div>
                <button type="button" class="rec-action rec-action--mf" id="btnMfSeleccionarRecorrido" disabled
                        title="Elegir clientes de esta hoja para armar manifiestos">
                    <i class="fa fa-check-square-o"></i> Seleccionar manifiesto
                </button>
                <div class="rec-mf-sel-bar d-none" id="barMfSeleccionRecorrido">
                    <span class="rec-mf-sel-count" id="lblMfSeleccionRecorrido">0 seleccionados</span>
                    <button type="button" class="rec-action rec-action--ghost" id="btnMfSelTodosRecorrido">
                        <i class="fa fa-check-square-o"></i> Todos
                    </button>
                    <button type="button" class="rec-action rec-action--mf" id="btnMfSelGenerarRecorrido" disabled>
                        <i class="fa fa-file-text-o"></i> Armar manifiestos
                    </button>
                    <button type="button" class="rec-action rec-action--cancel" id="btnMfSelCancelarRecorrido">
                        <i class="fa fa-times"></i> Cancelar
                    </button>
                </div>
                <button type="button" class="rec-action rec-action--mf" id="btnManifiestosRecorrido" disabled>
                    <i class="fa fa-file-text-o"></i> Manifiestos por lote
                </button>
                <button type="button" class="rec-action rec-action--add" id="btnNuevoClienteRecorrido" disabled>
                    <i class="fa fa-plus"></i> Agregar cliente
                </button>
            </div>
        </div>

        <div id="panelSugeridosRecorrido" class="rec-sugeridos-panel d-none">
            <div class="rec-sugeridos-head">
                <div>
                    <div class="rec-sugeridos-title"><i class="fa fa-calendar-check-o me-1"></i> Clientes programados para este dia</div>
                    <small class="text-muted-cc" id="lblSugeridosRecorrido">Segun dia, semana y unidad del establecimiento</small>
                </div>
                <div class="rec-sugeridos-actions">
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnToggleSugeridosRec">
                        <i class="fa fa-list"></i> Ver lista
                    </button>
                    <button type="button" class="btn btn-sm btn-success" id="btnAgregarSugeridosRec">
                        <i class="fa fa-download me-1"></i> Agregar seleccionados
                    </button>
                </div>
            </div>
            <div id="listaSugeridosRecorrido" class="rec-sugeridos-list d-none"></div>
        </div>
        <div id="listaClientesRecorrido" class="rec-clientes-list">
            <div class="rec-empty">
                <i class="fa fa-hand-pointer-o"></i>
                Elegi un recorrido y toca <strong>Clientes</strong> para ver la lista
            </div>
        </div>
    </div>

</div>

<div id="recStockOverlay" class="rec-stock-overlay" hidden>
    <div class="rec-stock-scrim" data-rs-close="1"></div>
    <aside class="rec-stock-drawer" role="dialog" aria-modal="true" aria-labelledby="recStockTitle">
        <header class="rec-stock-head">
            <div class="rec-stock-head-copy">
                <span class="rec-stock-kicker"><i class="fa fa-cubes"></i> Stock y visita</span>
                <h3 class="rec-stock-title" id="recStockTitle">Cliente</h3>
                <p class="rec-stock-sub" id="recStockSub">Mes actual</p>
            </div>
            <div class="rec-stock-head-tools">
                <label class="rec-stock-month">
                    <span>Mes</span>
                    <input type="month" id="recStockMes" class="form-control rec-input" />
                </label>
                <a class="rec-stock-full" id="recStockGestionLink" href="/Clientes/Gestion" target="_blank" rel="noopener">
                    Abrir gestión completa <i class="fa fa-external-link"></i>
                </a>
                <button type="button" class="rec-stock-close" data-rs-close="1" aria-label="Cerrar">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <label class="rec-stock-est">
                <span>Establecimiento</span>
                <select id="recStockEst" class="form-control rec-input"></select>
            </label>
        </header>
        <div class="rec-stock-loading" id="recStockLoading" hidden>
            <i class="fa fa-spinner fa-spin"></i>
            <span id="recStockLoadingMsg">Cargando…</span>
        </div>
        <div class="rec-stock-body" id="recStockBody"></div>
        <footer class="rec-stock-foot">
            <button type="button" class="rec-modal-btn rec-modal-btn--ghost" data-rs-close="1">Cerrar</button>
            <button type="button" class="rec-modal-btn rec-modal-btn--ok" id="btnRsGuardarVisita">
                <i class="fa fa-check"></i> Guardar visita
            </button>
        </footer>
    </aside>
</div>

@await Html.PartialAsync("~/Views/Entities/M_Camiones.cshtml")

<div class="modal fade rp-modal" id="modalClienteRecorrido" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rec-modal">
            <div class="modal-header rec-modal-header">
                <div>
                    <h5 class="modal-title m-0" id="modalClienteRecorridoTitulo">Cliente en recorrido</h5>
                    <small class="text-muted-cc" id="modalClienteRecorridoSub">Asignacion a la ruta seleccionada</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body rec-modal-body">
                <input type="hidden" id="crId" value="0" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label" for="crCliente">Cliente</label>
                        <div class="rp-select-plus">
                            <select id="crCliente" class="form-control rec-select"></select>
                            <a href="/Clientes/Gestion" target="_blank" class="rp-btn-plus" title="Nuevo cliente">
                                <i class="fa fa-plus"></i>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="crPosicion">Posicion</label>
                        <input type="number" id="crPosicion" class="form-control rec-input" min="1" value="1" />
                        <div id="avisoOrdenRecorridoCr" class="rp-orden-aviso" hidden>
                            <div class="rp-orden-aviso-text"></div>
                            <div class="rp-orden-aviso-actions">
                                <button type="button" class="btn btn-warning" data-orden-aviso="si">Sí, reemplazar y desplazar</button>
                                <button type="button" class="btn btn-outline-light" data-orden-aviso="no">No</button>
                            </div>
                            <div class="rp-orden-aviso-estado" hidden></div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label" for="crEstablecimiento">Establecimiento <span class="text-muted-cc">(opcional)</span></label>
                        <select id="crEstablecimiento" class="form-control rec-select"></select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label" for="crObservacion">Observacion para hoja de ruta</label>
                        <textarea id="crObservacion" class="form-control rec-input" rows="2" maxlength="500"
                                  placeholder="Notas que se imprimen en la columna Observacion de la hoja de ruta"></textarea>
                    </div>
                    <div class="col-md-6">
                        <div class="rp-activo-box">
                            <div class="rp-activo-box-head">
                                <span class="rp-activo-box-title">Estado en el recorrido</span>
                            </div>
                            <label class="rp-switch mb-0 rp-switch-block">
                                <input type="checkbox" id="crActivo" class="rp-switch-input" checked>
                                <span class="rp-switch-slider"></span>
                                <span class="rp-activo-estado-text" id="lblCrActivo">Activo</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="rp-activo-box rec-reprog-box">
                            <div class="rp-activo-box-head">
                                <span class="rp-activo-box-title">Reprogramado</span>
                            </div>
                            <label class="rp-switch mb-0 rp-switch-block">
                                <input type="checkbox" id="crReprogramado" class="rp-switch-input">
                                <span class="rp-switch-slider"></span>
                                <span class="rp-activo-estado-text" id="lblCrReprogramado">Normal</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer rec-modal-footer">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="btnGuardarClienteRecorrido">
                    <i class="fa fa-check me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade rp-modal" id="modalManifiestoRecorrido" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" id="mfModalDialog">
        <div class="modal-content rec-modal">
            <div class="modal-header rec-modal-header">
                <h5 class="modal-title m-0" id="modalManifiestoRecorridoTitulo">Generar manifiestos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body rec-modal-body">
                <input type="hidden" id="mfIdRecorrido" value="0" />
                <input type="hidden" id="mfModoExport" value="manifiesto" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="mfNombreManifiesto">Nombre</label>
                        <input type="text" id="mfNombreManifiesto" class="form-control rec-input" maxlength="120"
                               placeholder="Nombre del recorrido o del cliente" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="mfNumeroManifiesto">Manifiesto Nº inicial</label>
                        <input type="number" id="mfNumeroManifiesto" class="form-control rec-input" min="1" step="1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="mfFechaIntercambio">Fecha de programación</label>
                        <input type="date" id="mfFechaIntercambio" class="form-control rec-input" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="mfIdChofer">Chofer</label>
                        <select id="mfIdChofer" class="form-control rec-input"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="mfChoferAclaracion">Aclaración</label>
                        <input type="text" id="mfChoferAclaracion" class="form-control rec-input" maxlength="120"
                               placeholder="Se completa con el chofer; podés cambiarla" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="mfChoferDni">DNI</label>
                        <input type="text" id="mfChoferDni" class="form-control rec-input" maxlength="20" />
                    </div>
                    <div class="col-12 d-none" id="mfLotePreviewWrap">
                        <div class="mf-lote-caption">Previsualización del lote — la última columna es el número que se imprime</div>
                        <div class="mf-lote-table-wrap">
                            <table class="mf-lote-table">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th class="mf-lote-th-copias">
                                            Copias
                                            <input type="number" id="mfCopiasTodas" class="form-control rec-input mf-lote-copias mf-lote-copias-todas"
                                                   min="0" max="50" step="1" inputmode="numeric" placeholder="Todas"
                                                   title="Aplicar este valor a todos. Después podés cambiar cada fila." />
                                        </th>
                                        <th>Nº manifiesto cliente</th>
                                        <th class="mf-lote-th-num">Manifiesto Nº</th>
                                    </tr>
                                </thead>
                                <tbody id="mfLotePreviewBody"></tbody>
                            </table>
                        </div>
                        <div class="mf-lote-total" id="mfLotePreviewTotal"></div>
                    </div>
                    <div class="col-12 d-none" id="mfLoteOpdsWrap">
                        <label class="form-label" for="mfIdTransportistaOpds">N° estable. OPDS del transportista</label>
                        <input type="text" id="mfIdTransportistaOpds" class="form-control rec-input" maxlength="10"
                               inputmode="numeric" placeholder="El N°Estable. al entrar al manifiesto electrónico" />
                        <div class="form-text text-muted">Es el N°Estable. del instructivo OPDS (Idtransportista, 10 dígitos). Se guarda en este equipo.</div>
                        <label class="oa-check mt-2" for="mfGenerarLoteOpds">
                            <input type="checkbox" id="mfGenerarLoteOpds" />
                            <span class="oa-check-box" aria-hidden="true">
                                <i class="fa fa-check"></i>
                            </span>
                            <span class="oa-check-text">
                                <strong>También generar archivo de lote OPDS</strong>
                                <small>TXT del instructivo: un renglón por manifiesto, campos con ceros a la izquierda y ; para Enviar Archivo en Manifiesto por Lotes. Cada generador tiene que tener Id del ministerio.</small>
                            </span>
                        </label>
                    </div>
                    <div class="col-12">
                        <label class="oa-check" for="mfGenerarCertificados">
                            <input type="checkbox" id="mfGenerarCertificados" checked />
                            <span class="oa-check-box" aria-hidden="true">
                                <i class="fa fa-check"></i>
                            </span>
                            <span class="oa-check-text">
                                <strong>También generar certificados de tratamiento</strong>
                                <small>Se descargan el manifiesto y el certificado por separado</small>
                            </span>
                        </label>
                    </div>
                    <div id="mfCertificadosPanel" class="col-12">
                        <div class="row g-3 mt-0 pt-2 oa-cert-panel">
                            <div class="col-md-6">
                                <label class="form-label" for="mfFechaEmisionCert">Fecha de emisión</label>
                                <input type="date" id="mfFechaEmisionCert" class="form-control rec-input" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="mfNumeroCertificado">Nro. certificado (inicial)</label>
                                <input type="number" id="mfNumeroCertificado" class="form-control rec-input" min="1" step="1" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="mfFechaTratamientoCert">Fecha de tratamiento</label>
                                <input type="date" id="mfFechaTratamientoCert" class="form-control rec-input" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="mfNumeroOrdenCert">N° orden operaciones (inicial)</label>
                                <input type="number" id="mfNumeroOrdenCert" class="form-control rec-input" min="1" step="1" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer rec-modal-footer rec-modal-footer--actions">
                <button type="button" class="rec-modal-btn rec-modal-btn--ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="rec-modal-btn rec-modal-btn--txt" id="btnExportarTxtIntercambioRecorrido">
                    <i class="fa fa-download"></i> Exportar TXT
                </button>
                <button type="button" class="rec-modal-btn rec-modal-btn--ok" id="btnConfirmarManifiestoRecorrido">
                    <i class="fa fa-file-text-o"></i> Generar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
                <script src="~/js/CamionesManifiestos.js?v=7.4"></script>
    <script src="~/js/Entities/M_Camiones.js?v=8.2"></script>
    <script src="~/js/Recorridos.js?v=13.6"></script>
    <script src="~/js/RecorridosStock.js?v=1.1"></script>
}
