</div>

<!-- Modal Exito -->
<div class="modal fade w-100" id="exitoModal" tabindex="-1" aria-labelledby="exitoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content text-white" style="background: #323844">
            <div class="modal-header border-0 bg-success bg-opacity-10 colorEncabezado">
