@{
    ViewData["Title"] = "Contratos";
}

@section Estilos {
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/fixedheader/3.2.2/css/fixedHeader.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/css/Productora.css?v=1.0" rel="stylesheet" />
    <link href="~/css/disenopantallas.css?v=1.7" rel="stylesheet" />
    <link href="~/css/M_Generico.css" rel="stylesheet" />
    <link href="~/css/ContratosModal.css?v=1.3" rel="stylesheet" />
}

<div class="container-fluid mt-5">
    <div class="container page-99" style="margin-top:40px">
        <div class="cc-header shadow-lg rounded-4 p-4 mb-4">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-3">
                    <span class="cc-badge"><i class="fa fa-file-text-o"></i></span>
                    <div>
                        <h2 class="m-0 fw-800">Contratos</h2>
                        <small class="text-muted-cc">Vínculo cliente – establecimiento · vigencia · renovaciones</small>
                    </div>
                </div>
                <div class="ms-auto d-flex gap-4 flex-wrap align-items-center">
                    <div class="cc-stat">
                        <div class="label">Registros</div>
                        <div class="value"><strong id="kpiCantContratos">0</strong></div>
                    </div>
                    <div class="cc-stat">
                        <div class="label">Vigentes</div>
                        <div class="value"><strong id="kpiVigentesContratos">0</strong></div>
                    </div>
                    <button class="btn btn-success d-flex align-items-center px-3 py-2 btnnuevo" type="button" onclick="nuevoContrato()">
                        <i class="fa fa-plus-square me-2"></i> Nuevo contrato
                    </button>
                </div>
            </div>
        </div>

        <div class="card-glass p-3">
            <div class="dt-dark-wrap">
                <table class="dt-dark display nowrap compact" id="grd_Contratos" style="width:100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Id</th>
                            <th>Cliente</th>
                            <th>Establecimiento</th>
                            <th>Sucursal</th>
                            <th>F. contrato</th>
                            <th>Inicio</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                            <th class="text-center">Entregas</th>
                            <th class="text-center">Renov.</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Entities/M_Clientes.cshtml")
@await Html.PartialAsync("~/Views/Entities/M_ClientesEstablecimientos.cshtml")
@await Html.PartialAsync("~/Views/Entities/M_Contratos.cshtml")

@section Scripts {
    <script src="~/js/Entities/M_Clientes.js?v=1.7"></script>
    <script src="~/js/Entities/M_ClientesEstablecimientos.js?v=1.3"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://unpkg.com/pizzip@3.1.5/dist/pizzip.min.js"></script>
    <script src="https://unpkg.com/docxtemplater@3.37.9/build/docxtemplater.js"></script>
    <script src="~/js/ContratosDocumentos.js?v=1.9"></script>
    <script src="~/js/Entities/M_Contratos.js?v=2.3"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.2.2/js/dataTables.fixedHeader.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/Utils/moment.js"></script>
    <script src="~/js/Contratos.js?v=1.3"></script>
}
