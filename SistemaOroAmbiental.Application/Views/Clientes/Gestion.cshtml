@{
    Layout = "_LayoutModulo";
    ViewData["Title"] = "Clientes - Gestion";
    var id = (int)(ViewBag.Id ?? 0);
}

@section Estilos {
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/css/Productora.css?v=6.2" rel="stylesheet" />
    <link href="~/css/disenopantallas.css?v=6.2" rel="stylesheet" />
    <link href="~/css/M_Generico.css?v=6.2" rel="stylesheet" />
    <link href="~/css/ClientesGestion.css?v=10.6" rel="stylesheet" />
    <link href="~/css/ClientesEstablecimientos.css?v=5.4" rel="stylesheet" />
    <link href="~/css/ContratosModal.css?v=5.4" rel="stylesheet" />
}

<div class="cg-page">

    <div class="cg-header cc-header cg-header-hero shadow-lg rounded-4 p-3 mb-3">
        <div class="d-flex align-items-center gap-3 flex-wrap w-100">
            <a href="@Url.Action("Index", "Clientes")" class="cg-btn-back" title="Volver al listado">
                <i class="fa fa-arrow-left"></i>
            </a>

            <span class="cc-badge cg-header-badge">
                <i class="fa fa-user"></i>
            </span>

            <div class="flex-grow-1 min-w-0">
                <h2 class="m-0 fw-800 text-truncate" id="cgTituloCliente">@(id > 0 ? "Cargando..." : "Nuevo cliente")</h2>
                <small class="text-muted-cc d-none" id="cgSubtituloCliente"></small>
            </div>

            <div class="d-flex gap-2 flex-wrap align-items-center cg-header-actions">
                <a id="btnNuevaEntregaCg" class="btn btn-outline-light btn-sm cg-btn-action" href="#" hidden>
                    <i class="fa fa-truck me-1"></i> Nueva entrega
                </a>
                <button id="btnNuevoEstablecimientoCg" class="btn btn-outline-light btn-sm cg-btn-action" type="button" hidden>
                    <i class="fa fa-building me-1"></i> Nuevo establecimiento
                </button>
                <button id="btnNuevoContratoCg" class="btn btn-outline-light btn-sm cg-btn-action" type="button" hidden>
                    <i class="fa fa-file-text-o me-1"></i> Nuevo contrato
                </button>
                <button id="btnEliminarClienteCg" class="btn btn-outline-danger btn-sm" type="button" hidden>
                    <i class="fa fa-trash"></i>
                </button>
                <button id="btnGuardarClienteCg" class="btn btn-success btn-sm" type="button">
                    <i class="fa fa-check me-1"></i> <span id="lblGuardarClienteCg">@(id > 0 ? "Guardar" : "Registrar")</span>
                </button>
            </div>
        </div>
    </div>

    <div class="card-glass p-0 cg-card">

        <div class="rp-tabs-shell cg-tabs-shell">
            <ul class="nav rp-tabs-modern cg-tabs-scroll" id="cgTabsNav" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" id="tabBtnDatos" data-bs-toggle="tab" data-bs-target="#tabDatos" type="button" data-cg-tab="datos">
                        <i class="fa fa-id-card"></i><span>Datos</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnContactos" data-bs-toggle="tab" data-bs-target="#tabContactos" type="button" data-cg-tab="contactos" disabled>
                        <i class="fa fa-address-book"></i><span>Contactos</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnEstablecimientos" data-bs-toggle="tab" data-bs-target="#tabEstablecimientos" type="button" data-cg-tab="establecimientos" disabled>
                        <i class="fa fa-building"></i><span>Establecimientos</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnContratos" data-bs-toggle="tab" data-bs-target="#tabContratos" type="button" data-cg-tab="contratos" disabled>
                        <i class="fa fa-file-text-o"></i><span>Contratos</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnEntregas" data-bs-toggle="tab" data-bs-target="#tabEntregas" type="button" data-cg-tab="entregas" disabled>
                        <i class="fa fa-truck"></i><span>Entregas</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnRecorridos" data-bs-toggle="tab" data-bs-target="#tabRecorridos" type="button" data-cg-tab="recorridos" disabled>
                        <i class="fa fa-road"></i><span>Recorridos</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnControlMensual" data-bs-toggle="tab" data-bs-target="#tabControlMensual" type="button" data-cg-tab="controlMensual" disabled>
                        <i class="fa fa-calendar"></i><span>Control mensual</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnStockCliente" data-bs-toggle="tab" data-bs-target="#tabStockCliente" type="button" data-cg-tab="stockCliente" disabled>
                        <i class="fa fa-cubes"></i><span>Stock cliente</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnCuentaCorriente" data-bs-toggle="tab" data-bs-target="#tabCuentaCorriente" type="button" data-cg-tab="cuentaCorriente" disabled>
                        <i class="fa fa-credit-card"></i><span>Cuenta Corriente</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="tabBtnCobros" data-bs-toggle="tab" data-bs-target="#tabCobros" type="button" data-cg-tab="cobros" disabled>
                        <i class="fa fa-money"></i><span>Cobros</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content cg-tab-content" id="cgTabsContent">

            <!-- DATOS -->
            <div class="tab-pane fade show active" id="tabDatos">
                <div id="errorCamposCg" class="rp-error-panel d-none mb-3">
                    <div class="rp-error-icon"><i class="fa fa-exclamation-triangle"></i></div>
                    <div class="rp-error-content">
                        <div class="rp-error-title">No se pudo guardar</div>
                        <div class="rp-error-message"></div>
                    </div>
                    <button type="button" class="rp-error-close" id="btnCerrarErrorCg">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <input type="hidden" id="cgId" value="@id" />

                <div class="cg-form-panel">
                <form class="row g-3 cg-form" id="formDatosCliente">

                    <div class="col-12 cg-form-section">
                        <div class="cg-form-section-title">Identificacion</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Nombre</label>
                                <input id="cgNombre" class="form-control" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Nro cliente</label>
                                <input id="cgNumeroCliente" class="form-control" type="number" min="1" placeholder="Auto" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">CUIT</label>
                                <input id="cgCuit" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Sucursal</label>
                                <div class="rp-select-plus">
                                    <select id="cgSucursal" class="form-control"></select>
                                    <button type="button" class="rp-btn-plus" title="Agregar sucursal"
                                            data-config-nombre="Sucursales" data-config-controller="Sucursales">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Estado comercial</label>
                                <div class="rp-select-plus">
                                    <select id="cgEstado" class="form-control"></select>
                                    <button type="button" class="rp-btn-plus" title="Agregar estado"
                                            data-config-nombre="Estados de clientes" data-config-controller="ClientesEstados">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Calificacion</label>
                                <div class="rp-select-plus">
                                    <select id="cgCalificacion" class="form-control"></select>
                                    <button type="button" class="rp-btn-plus" title="Agregar calificacion"
                                            data-config-nombre="Calificaciones de clientes" data-config-controller="ClientesCalificaciones">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Motivo</label>
                                <div class="rp-select-plus">
                                    <select id="cgMotivo" class="form-control"></select>
                                    <button type="button" class="rp-btn-plus" title="Agregar motivo"
                                            data-config-nombre="Motivos de clientes" data-config-controller="ClientesMotivos">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-12" id="wrapMotivoDetalle" hidden>
                                <label class="form-label">Detalle del motivo</label>
                                <textarea id="cgMotivoDetalle" class="form-control" rows="2"></textarea>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Fecha inicio</label>
                                <input type="date" id="cgFechaInicio" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Licencia desde</label>
                                <input type="date" id="cgFechaLicenciaDesde" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Licencia hasta</label>
                                <input type="date" id="cgFechaLicenciaHasta" class="form-control" />
                            </div>
                            <div class="col-12">
                                <small class="text-muted">
                                    Si hoy cae entre las fechas de licencia, el cliente cuenta en <strong>Licencia</strong> del tablero
                                    (aunque el estado comercial siga en Activo). Las <strong>Alertas</strong> avisan licencias que vencen en los proximos 30 dias.
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 cg-form-section">
                        <div class="cg-form-section-title">Domicilio y ubicacion</div>
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label class="form-label">Calle</label>
                                <input id="cgCalle" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Numero</label>
                                <input id="cgNumero" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Piso / Depto</label>
                                <input id="cgPisoDepto" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Codigo postal</label>
                                <input id="cgCodPostal" class="form-control" />
                            </div>

                            <div class="col-md-10">
                                <label class="form-label">Provincia</label>
                                <div class="rp-select-plus">
                                    <select id="cgProvincia" class="form-control"></select>
                                    <button type="button" class="rp-btn-plus" title="Agregar provincia"
                                            data-config-nombre="Provincias" data-config-controller="Provincias">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Cod. provincia</label>
                                <input id="cgCodProvincia" class="form-control" readonly placeholder="-" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 cg-form-section">
                        <div class="cg-form-section-title">Contacto y fiscal</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Telefono</label>
                                <input id="cgTelefono" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Telefono alternativo</label>
                                <input id="cgTelefonoAlt" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Email</label>
                                <input id="cgEmail" class="form-control" type="email" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Profesion</label>
                                <div class="rp-select-plus">
                                    <select id="cgProfesion" class="form-control"></select>
                                    <button type="button" class="rp-btn-plus" title="Agregar profesion"
                                            data-config-nombre="Profesiones de Clientes" data-config-controller="ClientesProfesiones">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Condicion IVA</label>
                                <div class="rp-select-plus">
                                    <select id="cgCondicionIva" class="form-control"></select>
                                    <button type="button" class="rp-btn-plus" title="Agregar condicion IVA"
                                            data-config-nombre="Condiciones IVA" data-config-controller="CondicionesIva">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="rp-activo-box h-100">
                                    <div class="rp-activo-box-head">
                                        <span class="rp-activo-box-title">Estado del registro</span>
                                    </div>
                                    <label class="rp-switch mb-0 rp-switch-block">
                                        <input type="checkbox" id="cgActivo" class="rp-switch-input" checked>
                                        <span class="rp-switch-slider"></span>
                                        <span class="rp-activo-estado-text" id="lblActivoCg">Activo</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 cg-form-section cg-form-section--recoleccion">
                        <div class="cg-form-section-toggle"
                             data-bs-toggle="collapse"
                             data-bs-target="#cgRecoleccionBody"
                             aria-expanded="false"
                             aria-controls="cgRecoleccionBody">
                            <div class="cg-form-section-title mb-0">Recoleccion y recorrido</div>
                            <i class="fa fa-chevron-down cg-form-section-chev" aria-hidden="true"></i>
                        </div>
                        <div id="cgRecoleccionBody" class="collapse">
                        <div class="row g-3 cg-form-section-body">
                            <input type="hidden" id="cgEstId" />
                            <div class="col-md-3">
                                <label class="form-label">Id establecimiento</label>
                                <input id="cgIdEstablecimientoCliente" class="form-control" maxlength="8" />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">Tipo generador</label>
                                <div class="rp-select-plus">
                                    <select id="cgTipoGenerador" class="form-control"></select>
                                    <button type="button" class="rp-btn-plus" title="Agregar tipo generador"
                                            data-config-nombre="Tipos de generador" data-config-controller="ClientesTiposGenerador">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Dias y horarios</label>
                                <textarea id="cgDiasHorarios" class="form-control cg-dias-horarios-text" rows="4"
                                          maxlength="1000"></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label mb-2">Dias de recoleccion / unidad</label>
                                <div class="cg-rec-dias-table">
                                    <div class="cg-rec-dias-head-row">
                                        <span>Dia</span>
                                        <span>Unidad / Camion</span>
                                        <span>En ruta</span>
                                    </div>
                                    <div class="cg-rec-dia-row" data-dia="1">
                                        <span class="cg-rec-dia-label"><span class="cg-rec-row-num">1</span> Lunes</span>
                                        <select id="cgRecCamion1" class="form-control"></select>
                                        <span class="cg-rec-en-ruta" id="cgRecEnRuta1">-</span>
                                    </div>
                                    <div class="cg-rec-dia-row" data-dia="2">
                                        <span class="cg-rec-dia-label"><span class="cg-rec-row-num">2</span> Martes</span>
                                        <select id="cgRecCamion2" class="form-control"></select>
                                        <span class="cg-rec-en-ruta" id="cgRecEnRuta2">-</span>
                                    </div>
                                    <div class="cg-rec-dia-row" data-dia="3">
                                        <span class="cg-rec-dia-label"><span class="cg-rec-row-num">3</span> Miercoles</span>
                                        <select id="cgRecCamion3" class="form-control"></select>
                                        <span class="cg-rec-en-ruta" id="cgRecEnRuta3">-</span>
                                    </div>
                                    <div class="cg-rec-dia-row" data-dia="4">
                                        <span class="cg-rec-dia-label"><span class="cg-rec-row-num">4</span> Jueves</span>
                                        <select id="cgRecCamion4" class="form-control"></select>
                                        <span class="cg-rec-en-ruta" id="cgRecEnRuta4">-</span>
                                    </div>
                                    <div class="cg-rec-dia-row" data-dia="5">
                                        <span class="cg-rec-dia-label"><span class="cg-rec-row-num">5</span> Viernes</span>
                                        <select id="cgRecCamion5" class="form-control"></select>
                                        <span class="cg-rec-en-ruta" id="cgRecEnRuta5">-</span>
                                    </div>
                                    <div class="cg-rec-dia-row" data-dia="6">
                                        <span class="cg-rec-dia-label"><span class="cg-rec-row-num">6</span> Sabado</span>
                                        <select id="cgRecCamion6" class="form-control"></select>
                                        <span class="cg-rec-en-ruta" id="cgRecEnRuta6">-</span>
                                    </div>
                                    <div class="cg-rec-dia-row" data-dia="7">
                                        <span class="cg-rec-dia-label"><span class="cg-rec-row-num">7</span> Domingo</span>
                                        <select id="cgRecCamion7" class="form-control"></select>
                                        <span class="cg-rec-en-ruta" id="cgRecEnRuta7">-</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Semana recoleccion</label>
                                <select id="cgRecSemana" class="form-control"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Lista de precios</label>
                                <select id="cgRecListaPrecio" class="form-control"></select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Orden en recorrido</label>
                                <input id="cgOrdenRecorrido" class="form-control" type="number" min="1" step="1" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Kilos</label>
                                <input id="cgEstKilos" class="form-control" type="number" min="0" step="0.01" />
                            </div>

                            <div class="col-12">
                                <label class="form-label mb-2">Recorridos asignados</label>
                                <div id="cgRecorridosAsignados" class="cg-recorridos-inline"></div>
                            </div>
                        </div>
                        </div>
                    </div>

                </form>
                </div>

                <div class="rp-auditoria d-none mt-3" id="cgAuditoria">
                    <div id="cgInfoRegistro"></div>
                    <div id="cgInfoModificacion"></div>
                </div>
            </div>

            <!-- CONTACTOS -->
            <div class="tab-pane fade" id="tabContactos">
                <div class="rp-contact-page" id="sectionContactosCg">
                    <div class="rp-contact-hero mb-3">
                        <div>
                            <div class="text-muted small">Contactos del cliente</div>
                            <div class="rp-contact-hero-hint">
                                <i class="fa fa-info-circle"></i> Administra los contactos asociados.
                            </div>
                        </div>
                        <div class="rp-kpi-card-mini">
                            <span>Contactos</span>
                            <strong id="cgContactoCantidad">0</strong>
                        </div>
                    </div>
                    <div class="rp-contact-layout">
                        <div class="rp-contact-list-panel">
                            <h6><i class="fa fa-list"></i> Listado</h6>
                            <div id="cgListaContactos" class="rp-contact-list">
                                <div class="rp-contact-empty">Sin contactos cargados.</div>
                            </div>
                        </div>
                        <div class="rp-contact-form-panel">
                            <h6><i class="fa fa-user-plus"></i> <span id="cgContactoFormTitulo">Nuevo contacto</span></h6>
                            <input type="hidden" id="cgContactoId" />
                            <div class="row g-2">
                                <div class="col-md-12">
                                    <label class="form-label">Nombre</label>
                                    <input id="cgContactoNombre" class="form-control" maxlength="100" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Puesto</label>
                                    <input id="cgContactoPuesto" class="form-control" maxlength="100" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Telefono</label>
                                    <input id="cgContactoTelefono" class="form-control" maxlength="50" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Telefono alternativo</label>
                                    <input id="cgContactoTelefonoAlt" class="form-control" maxlength="50" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input id="cgContactoEmail" class="form-control" type="email" maxlength="100" />
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button type="button" id="btnGuardarContactoCg" class="btn btn-primary btn-sm">
                                    <i class="fa fa-check"></i> Guardar contacto
                                </button>
                                <button type="button" id="btnNuevoContactoCg" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa fa-plus"></i> Nuevo
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ESTABLECIMIENTOS -->
            <div class="tab-pane fade" id="tabEstablecimientos">
                <div class="cg-list-panel" data-cg-list="establecimientos">
                    <div class="cg-list-toolbar">
                        <div class="cg-list-toolbar-info">
                            <h6 class="cg-list-title"><i class="fa fa-building"></i> Establecimientos</h6>
                        </div>
                        <button type="button" id="btnNuevoEstTab" class="cg-btn cg-btn--success cg-btn--sm">
                            <i class="fa fa-plus"></i> Nuevo
                        </button>
                    </div>
                    <div class="cg-cards-grid" id="cgCards_establecimientos"></div>
                    <div class="dt-dark-wrap cg-table-wrap">
                        <table class="dt-dark display nowrap compact" id="grd_EstablecimientosCg" style="width:100%">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Id</th>
                                <th>Id establecimiento</th>
                                <th>Nombre</th>
                                <th>Domicilio</th>
                                <th>Partido</th>
