@{
    ViewData["Title"] = "Usuarios";
}

@section Estilos {
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/fixedheader/3.2.2/css/fixedHeader.dataTables.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <link href="~/css/usuarios.css?v=5.1" rel="stylesheet" />
    <link href="~/css/disenopantallas.css?v=1.0" rel="stylesheet" />
}

<div class="container-fluid mt-5">
    <div class="container page-99" style="margin-top:40px">
        <div class="cc-header shadow-lg rounded-4 p-4 mb-4">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-3">
                    <span class="cc-badge"><i class="fa fa-user-circle"></i></span>
                    <div>
                        <h2 class="m-0 fw-800">Usuarios</h2>
                        <small class="text-muted-cc">Gestión y listado de usuarios</small>
                    </div>
                </div>

                <div class="ms-auto d-flex gap-4 flex-wrap align-items-center">
                    <div class="cc-stat">
                        <div class="label">Usuarios</div>
                        <div class="value"><strong id="kpiCantUsuarios">0</strong></div>
                    </div>

                    <div class="dropdown cc-dd">
                        <button class="btn btn-secondary dropdown-toggle d-flex align-items-center"
                                type="button"
                                id="dropdownColumnas"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                data-bs-display="static"
                                data-bs-auto-close="outside">
                            <i class="fa fa-cog me-2"></i> Config. Columnas
                        </button>
                        <ul class="dropdown-menu cc-dropdown-menu" aria-labelledby="dropdownColumnas" id="configColumnasMenu"></ul>
                    </div>

                    <a class="btn btn-success d-flex align-items-center px-3 py-2 btnnuevo" onclick="nuevoUsuario()">
                        <i class="fa fa-plus-square me-2"></i> Nuevo
                    </a>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12">
                <div class="card-glass p-3">
                    <div class="tabla-wrap position-relative">
                        <div class="dt-dark-wrap">
                            <table class="dt-dark display nowrap compact" id="grd_Usuarios" style="width:100%">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Usuario</th>
                                        <th>Nombre</th>
                                        <th>Apellido</th>
                                        <th>Dni</th>
                                        <th>Telefono</th>
                                        <th>Direccion</th>
                                        <th>Rol</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="modalEdicion"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-usuarios modal-dialog-scrollable">
        <div class="modal-content rp-modal-shell">

            <div class="modal-header colorEncabezado rp-modal-header">
                <div class="rp-modal-title-wrap">
                    <h5 class="modal-title fw-bold" id="modalEdicionLabel">Usuario</h5>
                    <small class="rp-modal-subtitle">Gestión integral de datos, acceso y permisos por módulo</small>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body rp-modal-body">

                <div id="errorCampos" class="rp-error-panel d-none mb-3">
                    <div class="rp-error-icon">
                        <i class="fa fa-exclamation-triangle"></i>
                    </div>

                    <div class="rp-error-content">
                        <div class="rp-error-title">No se pudo guardar</div>
                        <div class="rp-error-message" id="errorCamposMensaje">Revisá los campos obligatorios.</div>
                    </div>

                    <button type="button"
                            class="rp-error-close"
                            onclick="cerrarErrorCampos()">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <div class="rp-tabs-shell">
                    <ul class="nav rp-tabs-modern">
                        <li class="nav-item">
                            <button class="nav-link active"
                                    data-bs-toggle="tab"
                                    data-bs-target="#tabDatosUsuario"
                                    type="button">
                                <i class="fa fa-user"></i>
                                <span>Datos del Usuario</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link"
                                    data-bs-toggle="tab"
                                    data-bs-target="#tabPermisosUsuario"
                                    type="button">
                                <i class="fa fa-lock"></i>
                                <span>Permisos</span>
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="tab-content">

                    <!-- TAB DATOS -->
                    <div class="tab-pane fade show active" id="tabDatosUsuario">

                        <div class="rp-form-layout">

                            <div class="rp-panel-card">
                                <div class="rp-panel-card-header">
                                    <div>
                                        <h6 class="mb-1">Información general</h6>
                                        <small>Completá los datos del usuario, sus datos de acceso y configuración base.</small>
                                    </div>

                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm"
                                            onclick="abrirSelectorPersonal()">
                                        <i class="fa fa-users"></i>
                                        Traer desde Personal
                                    </button>
                                </div>

                                <form class="row g-3 mt-1">
                                    <input type="hidden" id="txtId">

                                    <div class="col-md-4">
                                        <label class="form-label">Usuario</label>
                                        <input id="txtUsuario" class="form-control" required autocomplete="off">
                                        <div class="invalid-feedback">Campo obligatorio</div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Nombre</label>
                                        <input id="txtNombre" class="form-control" required autocomplete="off">
                                        <div class="invalid-feedback">Campo obligatorio</div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Apellido</label>
                                        <input id="txtApellido" class="form-control" autocomplete="off">
                                        <div class="invalid-feedback">Campo obligatorio</div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">DNI</label>
                                        <input id="txtDni" class="form-control" autocomplete="off">
                                        <div class="invalid-feedback">Campo obligatorio</div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Teléfono</label>
                                        <input id="txtTelefono" class="form-control" autocomplete="off">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Dirección</label>
                                        <input id="txtDireccion" class="form-control" autocomplete="off">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Correo</label>
                                        <input id="txtCorreo" class="form-control" autocomplete="off">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Rol</label>
                                        <select id="Roles" class="form-control"></select>
                                        <div class="invalid-feedback">Campo obligatorio</div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Estado</label>
                                        <select id="Estados" class="form-control"></select>
                                        <div class="invalid-feedback">Campo obligatorio</div>
                                    </div>

                                    <div class="col-md-4" id="divContrasena">
                                        <label class="form-label">Contraseña</label>
                                        <input id="txtContrasena" class="form-control" type="password" autocomplete="new-password">
                                        <div class="invalid-feedback">Campo obligatorio</div>
                                    </div>

                                    <div class="col-md-4" id="divContrasenaNueva" hidden="hidden">
                                        <label class="form-label">Nueva contraseña</label>
                                        <input id="txtContrasenaNueva" class="form-control" type="password" autocomplete="new-password">
                                    </div>
                                </form>
                            </div>

                        </div>

                    </div>

                    <!-- TAB PERMISOS -->
                    <div class="tab-pane fade" id="tabPermisosUsuario">

                        <div id="sectionPermisosUsuario" class="rp-perm-page rp-section-disabled">

                            <div class="rp-perm-hero">
                                <div class="rp-perm-hero-left">
                                    <div class="rp-perm-hero-avatar">
                                        <i class="fa fa-user-circle"></i>
                                    </div>

                                    <div class="rp-perm-hero-text">
                                        <div class="rp-perm-hero-label">Usuario seleccionado</div>
                                        <div class="rp-perm-hero-name" id="permUsuarioNombre">Nuevo</div>
                                        <div class="rp-perm-hero-hint" id="permisoHint">
                                            <i class="fa fa-info-circle"></i>
                                            Guardá el usuario para administrar permisos.
                                        </div>
                                    </div>
                                </div>

                                <div class="rp-perm-hero-right">
                                    <div class="rp-kpi-card-mini">
                                        <span>Módulos</span>
                                        <strong id="permCantModulos">0</strong>
                                    </div>

                                    <div class="rp-kpi-card-mini">
                                        <span>Activos</span>
                                        <strong id="permCantChecksActivos">0</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="rp-perm-toolbar">
                               

                                <div class="rp-perm-toolbar-right">
                                    <button id="btnPermisosTodos" class="btn btn-outline-primary" onclick="marcarTodosPermisos(true)">
                                        <i class="fa fa-check-square-o"></i>
                                        Todo
                                    </button>

                                    <button id="btnPermisosNinguno" class="btn btn-outline-secondary" onclick="marcarTodosPermisos(false)">
                                        <i class="fa fa-square-o"></i>
                                        Ninguno
                                    </button>
                                </div>
                            </div>

                            <div class="rp-perm-layout">

                                <!-- SIDEBAR MODULOS -->
                                <aside class="rp-mod-sidebar">
                                    <div class="rp-mod-sidebar-header">
                                        <div>
                                            <h6 class="mb-1">Módulos</h6>
                                            <small>Elegí un módulo para configurar sus permisos</small>
                                        </div>
                                    </div>

                                    <div class="rp-mod-search">
                                        <i class="fa fa-search"></i>
                                        <input id="txtBuscarModuloPermiso"
                                               type="text"
                                               class="form-control"
                                               placeholder="Buscar módulo...">
                                    </div>

                                    <div id="listaModulosPermisos" class="rp-mod-list">
                                        <div class="rp-perm-empty-state">
                                            Guardá el usuario para administrar permisos.
                                        </div>
                                    </div>
                                </aside>

                                <!-- DETALLE -->
                                <section class="rp-perm-detail">
                                    <div class="rp-perm-detail-top">
                                        <div class="rp-perm-detail-titlebox">
                                            <div class="rp-chip-soft">Módulo</div>
                                            <h3 id="permModuloNombre">Seleccioná un módulo</h3>
                                            <p id="permModuloDesc">Acá vas a poder activar o desactivar cada permiso de forma individual.</p>
                                        </div>

                                        <div class="rp-perm-detail-actions">
                                            <button type="button"
                                                    class="btn btn-outline-success btn-sm"
                                                    onclick="marcarPermisosModuloActual(true)">
                                                <i class="fa fa-check"></i>
                                                Activar módulo
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="marcarPermisosModuloActual(false)">
                                                <i class="fa fa-times"></i>
                                                Limpiar módulo
                                            </button>
                                        </div>
                                    </div>

                                    <div id="permDetalleContainer" class="rp-perm-cards-wrap">
                                        <div class="rp-perm-empty-state">
                                            Seleccioná un módulo para ver sus permisos.
                                        </div>
                                    </div>
                                </section>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer rp-modal-footer">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left"></i>
                    Volver
                </button>

                <button id="btnGuardar"
                        class="btn btn-primary"
                        onclick="guardarCambios()">
                    <i class="fa fa-check"></i>
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalSelectorPersonal">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rp-modal-dark">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa fa-users"></i>
                    Seleccionar Personal existente
                </h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input id="buscarPersonalSelector"
                       class="form-control mb-3"
                       placeholder="Buscar por nombre o DNI..." />

                <div id="listaPersonalSelector" class="rp-personal-grid"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-success" onclick="aplicarPersonalSeleccionado()">
                    <i class="fa fa-check"></i>
                    Aplicar datos
                </button>
            </div>

        </div>
    </div>
</div>



@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
    <script src="~/js/site.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.2.2/js/dataTables.fixedHeader.min.js"></script>

    <script src="~/js/Usuarios.js?v=5.1"></script>
}