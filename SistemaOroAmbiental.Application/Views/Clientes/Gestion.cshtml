            </div>
            <div class="modal-body">
                <input type="hidden" id="cgInteresAnio" />
                <input type="hidden" id="cgInteresMes" />
                <p class="cg-interes-hint mb-3">
                    El sistema sugiere un monto. Pueden editarlo o cancelar si el atraso no merece interés.
                    Al confirmar se suma al <strong>Debe</strong> (cuenta corriente) y aparece en el saldo de la hoja de ruta.
                </p>
                <div id="cgInteresAvisoExistente" class="cg-interes-aviso d-none" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Base adeudada del mes</label>
                        <input type="text" id="cgInteresBase" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">% interés</label>
                        <input type="number" id="cgInteresPct" class="form-control" min="0" step="0.01" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Importe a cargar</label>
                        <input type="text" id="cgInteresImporte" class="form-control Inputmiles" inputmode="decimal" autocomplete="off" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha</label>
                        <input type="date" id="cgInteresFecha" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Concepto</label>
                        <input type="text" id="cgInteresConcepto" class="form-control" maxlength="200" />
                    </div>
                </div>
            </div>
            <div class="modal-footer rp-modal-footer">
                <button class="rp-btn rp-btn-soft" data-bs-dismiss="modal"><i class="fa fa-times"></i> Cancelar</button>
                <button class="rp-btn rp-btn-primary" id="btnConfirmarInteresCg" type="button"><i class="fa fa-check"></i> Confirmar interés</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal historial de intereses -->
<div class="modal fade rp-modal" id="modalInteresesHistCg" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rp-modal-content">
            <div class="modal-header rp-modal-header">
                <div>
                    <div class="rp-modal-title"><i class="fa fa-eye"></i> Intereses cargados</div>
                    <div class="rp-modal-sub" id="cgInteresesHistSub">Historial del cliente</div>
                </div>
                <button type="button" class="btn-close rp-btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="cgInteresesHistResumen" class="cg-interes-hist-resumen mb-3"></div>
                <div id="cgInteresesHistBody" class="cg-interes-hist-body"></div>
            </div>
            <div class="modal-footer rp-modal-footer">
                <button class="rp-btn rp-btn-soft" data-bs-dismiss="modal"><i class="fa fa-times"></i> Cerrar</button>
            </div>
        </div>
    </div>
</div>

