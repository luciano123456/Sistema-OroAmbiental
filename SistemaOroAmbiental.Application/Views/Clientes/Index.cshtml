@{
    Layout = "_LayoutModulo";
    ViewData["Title"] = "Clientes";
}

@section Estilos {

    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/fixedheader/3.2.2/css/fixedHeader.dataTables.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <link href="~/css/Productora.css?v=6.2" rel="stylesheet" />
    <link href="~/css/disenopantallas.css?v=6.2" rel="stylesheet" />
    <link href="~/css/M_Generico.css?v=6.2" rel="stylesheet" />
    <link href="~/css/Clientes.css?v=6.9" rel="stylesheet" />
}

<div class="cl-page">

    <div class="cc-header shadow-lg rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center gap-3 flex-wrap">

            <div class="d-flex align-items-center gap-3">
                <span class="cc-badge cl-badge">
                    <i class="fa fa-users"></i>
                </span>

                <div>
                    <h2 class="m-0 fw-800">Clientes</h2>
                </div>
            </div>

            <div class="ms-auto d-flex gap-3 flex-wrap align-items-center">
                <div class="cc-stat">
                    <div class="label">Total</div>
                    <div class="value"><strong id="kpiCantClientes">0</strong></div>
                </div>

                <div class="dropdown cc-dd">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownColumnas"
                            data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside">
                        <i class="fa fa-cog me-2"></i> Columnas
                    </button>
                    <ul class="dropdown-menu cc-dropdown-menu" id="configColumnasMenu"></ul>
                </div>

                <button class="btn btn-success d-flex align-items-center px-3 py-2 btnnuevo" type="button" onclick="nuevoCliente()">
                    <i class="fa fa-plus-square me-2"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="cl-kpis-dashboard mb-4">
        <div class="cl-kpi-card cl-kpi-activos">
            <div class="lbl"><i class="fa fa-check-circle me-1"></i> Activos</div>
            <div class="val" id="kpiActivos">0</div>
        </div>
        <div class="cl-kpi-card cl-kpi-suspendidos">
            <div class="lbl"><i class="fa fa-pause-circle me-1"></i> Suspendidos</div>
            <div class="val" id="kpiSuspendidos">0</div>
        </div>
        <div class="cl-kpi-card cl-kpi-baja">
            <div class="lbl"><i class="fa fa-times-circle me-1"></i> Baja</div>
            <div class="val" id="kpiBaja">0</div>
            <div class="sub"><span id="kpiBajasMes">0</span> este mes</div>
        </div>
        <div class="cl-kpi-card cl-kpi-licencia">
            <div class="lbl"><i class="fa fa-calendar me-1"></i> Licencia</div>
            <div class="val" id="kpiLicencia">0</div>
        </div>
        <div class="cl-kpi-card cl-kpi-alertas">
            <div class="lbl"><i class="fa fa-exclamation-triangle me-1"></i> Alertas</div>
            <div class="val" id="kpiAlertasLicencia">0</div>
        </div>
    </div>

    <div id="panelAlertasLicencia" class="cl-alertas-panel mb-3 d-none">
        <div class="cl-alertas-head">
            <div class="cl-alertas-head-main">
                <span class="cl-alertas-head-icon"><i class="fa fa-bell"></i></span>
                <div>
                    <div class="cl-alertas-title">Licencias por vencer</div>
                    <div class="cl-alertas-sub">Clientes en licencia que vencen en los proximos 31 dias</div>
                </div>
            </div>
            <span class="cl-alertas-count" id="clAlertasLicenciaCount">0</span>
        </div>
        <div id="listaAlertasLicencia" class="cl-alertas-list"></div>
    </div>

    <div class="card-glass p-3 cl-grid-card">
        <div class="dt-dark-wrap">
            <table class="dt-dark display" id="grd_Clientes"
                   data-dt-dblclick-url="/Clientes/Gestion?id={id}" style="width:100%">
                <thead>
                    <tr>
                        <th></th>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>CUIT</th>
                        <th>Sucursal</th>
                        <th>Provincia</th>
                        <th>Profesion</th>
                        <th>Condicion IVA</th>
                        <th>Telefono</th>
                        <th>Email</th>
                        <th>Activo</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/js/Clientes.js?v=6.11"></script>
}
