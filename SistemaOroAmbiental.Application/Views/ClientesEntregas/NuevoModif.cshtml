@{
    Layout = "_LayoutModulo";
    ViewData["Title"] = "Entregas - Nuevo / Modificar";
    var id = (int)(ViewBag.IdEntrega ?? ViewBag.Id ?? 0);
    var idCliente = (int)(ViewBag.IdCliente ?? 0);
    var volverCliente = ViewBag.VolverCliente == true;
}

@section Estilos {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/css/disenopantallas.css?v=8.1" rel="stylesheet" />
    <link href="~/css/M_Generico.css?v=5.2" rel="stylesheet" />
    <link href="~/css/VentasNuevoModif.css?v=5.2" rel="stylesheet" />
    <link href="~/css/ClientesEntregas.css?v=5.6" rel="stylesheet" />
    <link href="~/css/ContratosModal.css?v=5.4" rel="stylesheet" />
}

<div class="ventanew entregas-nuevo">

    <div class="vn-actions-pro">
        <div class="vn-actions-header">
            <a href="@(volverCliente && idCliente > 0 ? Url.Action("Gestion", "Clientes", new { id = idCliente }) : Url.Action("Index", "ClientesEntregas"))"
               class="vn-btn-soft text-decoration-none"
               title="@(volverCliente && idCliente > 0 ? "Volver al cliente" : "Volver al listado")">
                <i class="fa fa-arrow-left"></i>
            </a>
            <div class="icon">
                <i class="fa fa-truck"></i>
            </div>
            <div class="title" id="tituloPaginaEntrega">Nueva entrega</div>
        </div>

        <div class="vn-actions-right">
            <button class="vn-btn-main-pro" id="btnGuardarEntrega" type="button">
                <i class="fa fa-check"></i>
                <span id="lblGuardarEntrega">Registrar entrega</span>
            </button>
            <button id="btnEliminarEntrega" class="vn-btn-soft-danger" type="button" hidden>
                <i class="fa fa-trash"></i> Eliminar
            </button>
        </div>
    </div>

    <div class="vn-grid">

        <div class="vn-card vn-card--entrega-unica">
            <div class="vn-card-head">
                <div class="t">
                    <i class="fa fa-truck"></i>
                    Entrega completa
                </div>
                <small class="vn-card-head-hint">Datos, productos, recuperados y cobros en una sola vista</small>
            </div>

            <div class="vn-entrega-body">

                <div id="errorCamposEntrega" class="rp-error-panel d-none mb-3">
                    <div class="rp-error-icon"><i class="fa fa-exclamation-triangle"></i></div>
                    <div class="rp-error-content">
                        <div class="rp-error-title">No se pudo guardar</div>
                        <div class="rp-error-message"></div>
                    </div>
                    <button type="button" class="rp-error-close" onclick="cerrarErrorEntrega()">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <div id="alertEntregaCobros" class="vn-alert-warning mb-3" hidden>
                    <i class="fa fa-info-circle"></i>
                    Esta entrega tiene cobros. Podes editarlos abajo; los cambios se aplican al guardar (caja y cuenta corriente).
                </div>

                <div id="alertProductoEntregaRecuperado" class="vn-alert-warning mb-3" hidden>
                    <i class="fa fa-exclamation-triangle"></i>
                    Algunos productos figuran en <strong>Productos</strong> (entrega/retiro) y en <strong>Productos recuperados</strong>. Podes guardar igual; revisa que las cantidades sean las correctas.
                </div>

                <input type="hidden" id="Entrega_Id" value="@id" />

                <!-- DATOS -->
                <div class="vn-section active vn-section-block vn-sec-datos" id="sec-datos" data-sec="datos">

                    <div class="vn-subtitle">
                        <div class="i"><i class="fa fa-info-circle"></i></div>
                        <div class="txt">
                            <div class="t1">Datos de la entrega</div>
                            <div class="t2">Cliente, estado, fecha y notas</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label vn-label">Cliente</label>
                            <select id="cCliente" class="form-select vn-input"></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label vn-label">Fecha</label>
                            <input type="date" id="cFecha" class="form-control vn-input" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label vn-label">Estado entrega</label>
                            <div class="vn-select-plus">
                                <select id="cEstado" class="form-select vn-input"></select>
                                <button type="button"
                                        id="btnAtajoEstadoEntrega"
                                        class="vn-btn-plus"
                                        title="Agregar estado de entrega"
                                        data-config-nombre="Estados Entregas"
                                        data-config-controller="EntregasEstados">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label vn-label">Camion</label>
                            <div class="vn-select-plus">
                                <select id="cCamion" class="form-select vn-input"></select>
                                <button type="button" class="vn-btn-plus" title="Agregar camion" onclick="abrirConfiguracion('Camiones', 'Camiones'); return false;">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label vn-label">Establecimiento</label>
                            <select id="cEstablecimiento" class="form-select vn-input" required></select>
                            <div class="form-text text-muted">Obligatorio: la entrega se imputa al establecimiento.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label vn-label">Nota al cliente</label>
                            <textarea id="cNotaCliente" class="form-control vn-input" rows="2" placeholder="Visible para el cliente..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label vn-label">Nota interna</label>
                            <textarea id="cNota" class="form-control vn-input" rows="3" placeholder="Observaciones internas..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- PRODUCTOS -->
                <div class="vn-section active vn-section-block vn-sec-productos" id="sec-productos" data-sec="productos">

                    <div class="vn-subtitle">
                        <div class="i"><i class="fa fa-cubes"></i></div>
                        <div class="txt">
                            <div class="t1">Productos <span class="vn-sec-count" id="cntProductos">(0)</span></div>
                            <div class="t2">Entrega descuenta inventario · Retiro baja stock en poder del cliente</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap align-items-center vn-sec-toolbar">
                        <div class="vn-agregar-wrap" id="wrapAgregarLinea">
                            <span class="vn-agregar-arrow" aria-hidden="true">
                                <i class="fa fa-long-arrow-down"></i> Agrega productos aca
                            </span>
                            <button class="btn btn-outline-light vn-btn vn-btn-agregar-hint" id="btnAgregarLinea" type="button">
                                <i class="fa fa-plus"></i> Agregar producto
                            </button>
                        </div>
                        <button class="btn btn-success" id="btnCrearProducto" type="button">
                            <i class="fa fa-cube"></i> Crear producto
                        </button>
                    </div>

                    <div class="vn-gridtable en-lineas-wrap" id="tblLineasEntrega">
                        <div class="en-lineas" id="tbodyLineasEntrega"></div>
                    </div>

                    <div id="lblSinLineas" class="vn-empty vn-empty-entrega">
                        <i class="fa fa-inbox"></i>
                        Sin productos cargados
                        <small class="d-block">Usa Agregar producto para comenzar</small>
                    </div>
                </div>

                <!-- PRODUCTOS RECUPERADOS -->
                <div class="vn-section active vn-section-block vn-sec-recuperados" id="sec-recuperados" data-sec="recuperados">

                    <div class="vn-subtitle">
                        <div class="i"><i class="fa fa-recycle"></i></div>
                        <div class="txt">
                            <div class="t1">Productos recuperados <span class="vn-sec-count" id="cntRecuperados">(0)</span></div>
                            <div class="t2">Entran a inventario recuperado (no al stock vendible)</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap align-items-center vn-sec-toolbar">
                        <div class="vn-agregar-wrap" id="wrapAgregarRecuperado">
                            <span class="vn-agregar-arrow" aria-hidden="true">
                                <i class="fa fa-long-arrow-down"></i> Agrega recuperados aca
                            </span>
                            <button class="btn btn-outline-success vn-btn vn-btn-agregar-hint" id="btnAgregarRecuperado" type="button">
                                <i class="fa fa-plus"></i> Agregar recuperado
                            </button>
                        </div>
                    </div>

                    <div class="vn-gridtable en-lineas-wrap" id="tblLineasRecuperados">
                        <div class="en-lineas" id="tbodyLineasRecuperados"></div>
                    </div>

                    <div id="lblSinRecuperados" class="vn-empty vn-empty-entrega">
                        <i class="fa fa-recycle"></i>
                        Sin productos recuperados
                        <small class="d-block">Usa Agregar recuperado si el cliente devolvio material</small>
                    </div>
                </div>

                <!-- COBROS -->
                <div class="vn-section active vn-section-block vn-sec-cobros" id="sec-cobros" data-sec="cobros">

                    <div class="vn-subtitle">
                        <div class="i"><i class="fa fa-money"></i></div>
                        <div class="txt">
                            <div class="t1">Cobros <span class="vn-sec-count" id="cntCobros">(0)</span></div>
                            <div class="t2">Se registran en caja y cuenta corriente al guardar</div>
                        </div>
                    </div>

                    <div id="lblCobrosHint" class="cm-cobros-hint mb-3">
                        <i class="fa fa-info-circle"></i>
                        <span id="lblCobrosHintText">Agrega filas de cobro como en productos. Nada se registra hasta guardar la entrega.</span>
                    </div>

                    <div id="panelCobrosEntrega">
                        <div class="cm-cobros-kpis">
                            <div class="cm-cobros-kpi">
                                <div class="lbl">Total entrega</div>
                                <div class="val" id="cobroTotEntrega">$ 0,00</div>
                            </div>
                            <div class="cm-cobros-kpi">
                                <div class="lbl">Total pagado</div>
                                <div class="val cm-cobros-kpi--ok" id="cobroTotPagado">$ 0,00</div>
                            </div>
                            <div class="cm-cobros-kpi cm-cobros-kpi--pend">
                                <div class="lbl">Saldo pendiente</div>
                                <div class="val" id="cobroSaldoPend">$ 0,00</div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap vn-sec-toolbar">
                            <div class="vn-agregar-wrap vn-agregar-wrap--cobros" id="wrapAgregarCobro">
                                <span class="vn-agregar-arrow" aria-hidden="true">
                                    <i class="fa fa-long-arrow-down"></i> Agrega cobros aca
                                </span>
                                <button type="button" class="btn btn-outline-light vn-btn vn-btn-agregar-hint" id="btnAgregarCobroEntrega">
                                    <i class="fa fa-plus"></i> Agregar cobro
                                </button>
                            </div>
                        </div>

                        <div class="vn-gridtable">
                            <table class="table vn-table" id="tblCobrosEntrega">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Sucursal</th>
                                        <th>Cuenta</th>
                                        <th>Concepto</th>
                                        <th class="text-end">Importe</th>
                                        <th style="width:48px"></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyCobrosEntrega"></tbody>
                            </table>
                        </div>

                        <div id="lblSinCobros" class="vn-empty vn-empty-entrega mt-2">
                            <i class="fa fa-credit-card"></i>
                            Sin cobros cargados
                            <small class="d-block">Usa Agregar cobro para comenzar</small>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- PANEL RESUMEN -->
        <aside class="vn-card vn-card--resumen-sticky">
            <div class="vn-card-head">
                <div class="t">
                    <i class="fa fa-line-chart"></i>
                    Resumen
                </div>
            </div>

            <div class="p-3 vn-summary">
                <div class="vn-stat">
                    <div class="lbl">Subtotal</div>
                    <div class="val" id="totSubtotal">$ 0,00</div>
                </div>
                <div class="vn-stat">
                    <div class="lbl">Descuentos</div>
                    <div class="val" id="totDescuentos">$ 0,00</div>
                </div>
                <div class="vn-stat">
                    <div class="lbl">IVA</div>
                    <div class="val" id="totIva">$ 0,00</div>
                </div>
                <div class="vn-stat vn-stat-total">
                    <div class="lbl">Total entrega</div>
                    <div class="val" id="totImporte">$ 0,00</div>
                </div>
                <div class="vn-stat">
                    <div class="lbl">Pagado contrato</div>
                    <div class="val cm-resumen-pagado" id="totPagadoResumen">$ 0,00</div>
                </div>
                <div class="vn-stat">
                    <div class="lbl">Saldo pendiente</div>
                    <div class="val cm-resumen-saldo" id="totSaldoResumen">$ 0,00</div>
                </div>
            </div>
        </aside>

    </div>
</div>

<partial name="~/Views/Entities/M_Productos.cshtml" />
<partial name="~/Views/Entities/M_Contratos.cshtml" />

@section Scripts {
    <script>
        window.CM_INIT = {
            id: @(id),
            idCliente: @(idCliente),
            volverCliente: @(volverCliente ? "true" : "false"),
            urlVolverCliente: null
        };
        if (window.CM_INIT.volverCliente && window.CM_INIT.idCliente > 0) {
            window.CM_INIT.urlVolverCliente = "/Clientes/Gestion?id=" + window.CM_INIT.idCliente;
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/Entities/M_Productos.js?v=5.5"></script>
    <script src="~/js/ContratosDocumentos.js?v=5.3"></script>
    <script src="~/js/Entities/M_Contratos.js?v=5.4"></script>
    <script src="~/js/ClientesEntregasNuevoModif.js?v=6.7"></script>
}
