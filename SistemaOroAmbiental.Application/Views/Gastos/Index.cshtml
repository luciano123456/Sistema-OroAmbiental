@{
    ViewData["Title"] = "Gastos";
}

@section Estilos {
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/fixedheader/3.2.2/css/fixedHeader.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/css/Productora.css?v=1.0" rel="stylesheet" />
    <link href="~/css/disenopantallas.css?v=1.7" rel="stylesheet" />
    <link href="~/css/M_Generico.css" rel="stylesheet" />
    <link href="~/css/Ventas.css?v=1.0" rel="stylesheet" />
    <link href="~/css/Gastos.css?v=2.2" rel="stylesheet" />
}

<div class="container-fluid mt-4 ventas-index gastos-index">

    <div class="vi-header cc-header shadow-lg rounded-4 p-3 mb-3">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="cc-badge"><i class="fa fa-money"></i></span>
            <div>
                <h2 class="m-0 fw-800">Gastos</h2>
                <small class="text-muted-cc">Egresos registrados · impacto en caja</small>
            </div>
            <div class="ms-auto d-flex gap-2 flex-wrap">
                <button id="btnRefreshGastos" class="btn btn-outline-light vi-btn" type="button">
                    <i class="fa fa-refresh me-2"></i> Actualizar
                </button>
                <button id="btnNuevoGasto" class="btn btn-success vi-btn" type="button" data-permiso="crear" data-modulo="Gastos">
                    <i class="fa fa-plus me-2"></i> Nuevo gasto
                </button>
            </div>
        </div>
    </div>

    <div class="cc-card">
        <div class="cc-card-body">

            <div class="rp-filtros-wrap mb-3">
                <div class="rp-filtros-head" data-bs-toggle="collapse" data-bs-target="#panelFiltrosGastos" aria-expanded="false">
                    <div class="title">
                        <i class="fa fa-filter"></i>
                        <span>Filtros</span>
                    </div>
                    <i class="fa fa-chevron-down chev"></i>
                </div>
                <div id="panelFiltrosGastos" class="collapse">
                    <div class="rp-filtros-body">
                        <div class="row g-3">
                            <div class="col-md-2">
                                <div class="rp-filter-label">Fecha desde</div>
                                <input type="date" id="fFechaDesde" class="rp-filter-input" />
                            </div>
                            <div class="col-md-2">
                                <div class="rp-filter-label">Fecha hasta</div>
                                <input type="date" id="fFechaHasta" class="rp-filter-input" />
                            </div>
                            <div class="col-md-2">
                                <div class="rp-filter-label">Categoría</div>
                                <select id="fCategoria" class="rp-filter-select select2" style="width:100%"></select>
                            </div>
                            <div class="col-md-2">
                                <div class="rp-filter-label">Sucursal</div>
                                <select id="fSucursal" class="rp-filter-select select2" style="width:100%"></select>
                            </div>
                            <div class="col-md-2">
                                <div class="rp-filter-label">Cuenta</div>
                                <select id="fCuenta" class="rp-filter-select select2" style="width:100%"></select>
                            </div>
                            <div class="col-md-2">
                                <div class="rp-filter-label">Importe mín.</div>
                                <input type="number" step="0.01" id="fImporteMin" class="rp-filter-input" placeholder="0" />
                            </div>
                            <div class="col-md-12">
                                <div class="rp-filter-label">Concepto contiene</div>
                                <input type="text" id="fConcepto" class="rp-filter-input" placeholder="Buscar por concepto..." />
                            </div>
                        </div>
                        <div class="rp-filtros-actions mt-3">
                            <button class="btn btn-outline-light vi-btn" type="button" onclick="limpiarFiltrosGastos()">
                                <i class="fa fa-eraser"></i> Limpiar
                            </button>
                            <button class="btn btn-primary vi-btn" type="button" onclick="aplicarFiltrosGastos()">
                                <i class="fa fa-check"></i> Aplicar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cc-kpis gastos-kpis">
                <div class="cc-kpi">
                    <div class="lbl">Gastos</div>
                    <div class="val" id="kpiCantGastos">0</div>
                </div>
                <div class="cc-kpi">
                    <div class="lbl">Total gastado</div>
                    <div class="val" id="kpiTotalGastos">$ 0,00</div>
                </div>
                <div class="cc-kpi">
                    <div class="lbl">IVA</div>
                    <div class="val" id="kpiTotalIva">$ 0,00</div>
                </div>
            </div>

            <div class="cc-toolbar mb-2">
                <div class="cc-toolbar-actions"></div>
                <div class="dropdown cc-dd">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownColumnasGastos"
                            data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside">
                        <i class="fa fa-cog me-2"></i> Config. Columnas
                    </button>
                    <ul class="dropdown-menu cc-dropdown-menu" id="configColumnasMenu"></ul>
                </div>
            </div>

            <div class="dt-dark-wrap">
                <table class="dt-dark display nowrap compact" id="grd_Gastos" style="width:100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Fecha</th>
                            <th>Categoría</th>
                            <th>Sucursal</th>
                            <th>Cuenta</th>
                            <th>Ref.</th>
                            <th>Concepto</th>
                            <th class="text-end">Neto</th>
                            <th class="text-end">IVA %</th>
                            <th class="text-end">IVA</th>
                            <th class="text-end">Otros imp.</th>
                            <th class="text-end">Total</th>
                            <th>Nota</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- Análisis (solo visible con datos) -->
    <div class="cc-card mt-3" id="dashWrap" style="display:none;" data-permiso="dashboard" data-modulo="Gastos">
        <div class="cc-card-body">
            <div class="accordion rp-acc" id="accordionDashboards">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="dashHeadGastos">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#dashBodyGastos" aria-expanded="false">
                            <i class="fa fa-bar-chart me-2"></i> Análisis de gastos
                        </button>
                    </h2>
                    <div id="dashBodyGastos" class="accordion-collapse collapse" data-bs-parent="#accordionDashboards">
                        <div class="accordion-body gastos-dash-body">
                            <div class="rp-dash-grid gastos-dash-grid">
                                <div class="rp-dash-card gastos-dash-card">
                                    <div class="rp-dash-title gastos-dash-title">
                                        <span class="t"><i class="fa fa-pie-chart"></i> Por categoría</span>
                                    </div>
                                    <div class="gastos-dash-chart-wrap">
                                        <canvas id="chartCategoria"></canvas>
                                    </div>
                                </div>
                                <div class="rp-dash-card gastos-dash-card">
                                    <div class="rp-dash-title gastos-dash-title">
                                        <span class="t"><i class="fa fa-building"></i> Por cuenta</span>
                                    </div>
                                    <div class="gastos-dash-chart-wrap">
                                        <canvas id="chartCuenta"></canvas>
                                    </div>
                                </div>
                                <div class="rp-dash-card gastos-dash-card">
                                    <div class="rp-dash-title gastos-dash-title">
                                        <span class="t"><i class="fa fa-line-chart"></i> Evolución mensual</span>
                                    </div>
                                    <div class="gastos-dash-chart-wrap">
                                        <canvas id="chartMes"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@await Html.PartialAsync("~/Views/Entities/M_Gastos.cshtml")

@section Scripts {
    <script src="~/js/Entities/M_Gastos.js?v=1.4"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.2.2/js/dataTables.fixedHeader.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/Utils/moment.js"></script>
    <script src="~/js/Gastos.js?v=2.3"></script>
}
